<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Program Kerja</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Title -->
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Edit Program Kerja</h2>
                    <p class="text-muted mb-0">Ubah informasi program kerja sesuai kebutuhan perencanaan.</p>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="card p-4 bg-white">
                            <form action="/lembaga-admin/proker/edit/<%= proker.id %>" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Nama Program Kerja</label>
                                    <input type="text" class="form-control" name="nama_program" value="<%= proker.nama_program %>" required>
                                </div>

                                <% if (userSession.role === 'admin_lembaga') { %>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small">Bidang Penanggung Jawab</label>
                                        <select class="form-select" name="bidangId" required>
                                            <option value="">-- Pilih Bidang --</option>
                                            <% if (bidangs && bidangs.length > 0) { %>
                                                <% bidangs.forEach(b => { %>
                                                    <option value="<%= b.id %>" <%= proker.bidangId === b.id ? 'selected' : '' %>><%= b.nama_bidang %></option>
                                                <% }) %>
                                            <% } %>
                                        </select>
                                    </div>
                                <% } %>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Bulan Pelaksanaan (Centang Bulan 1 s.d. 12)</label>
                                    <% 
                                        let activeMonths = [];
                                        if (proker.waktu_pelaksanaan) {
                                            activeMonths = String(proker.waktu_pelaksanaan).split(',').map(item => item.trim());
                                        }
                                    %>
                                    <div class="row g-2 bg-light p-3 rounded border">
                                        <% for(let i = 1; i <= 12; i++) { %>
                                            <div class="col-3 text-center">
                                                <div class="form-check d-inline-block">
                                                    <input class="form-check-input" type="checkbox" name="bulan" value="<%= i %>" id="bulan<%= i %>" <%= activeMonths.includes(String(i)) ? 'checked' : '' %>>
                                                    <label class="form-check-label small fw-bold d-block" for="bulan<%= i %>">Bulan <%= i %></label>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Status Program</label>
                                    <select class="form-select" name="status">
                                        <option value="Direncanakan" <%= proker.status === 'Direncanakan' ? 'selected' : '' %>>Direncanakan</option>
                                        <option value="Sedang Berjalan" <%= proker.status === 'Sedang Berjalan' ? 'selected' : '' %>>Sedang Berjalan</option>
                                        <option value="Selesai" <%= proker.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
                                    </select>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold small">Deskripsi / Sasaran</label>
                                    <textarea class="form-control" name="deskripsi" rows="3"><%= proker.deskripsi %></textarea>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary fw-bold py-2 px-4">
                                        <i class="fas fa-save me-1"></i> Simpan Perubahan
                                    </button>
                                    <a href="/lembaga-admin/proker" class="btn btn-outline-secondary fw-bold py-2 px-3">Batal</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
