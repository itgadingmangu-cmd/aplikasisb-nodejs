<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin Lembaga</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .icon-box {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <!-- Konten Utama Dashboard Lembaga -->
        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Title & Tombol Aksi Kanan Atas -->
                <div class="row align-items-center mb-4 g-3">
                    <div class="col-lg-8">
                        <h2 class="fw-bold text-dark mb-1">Panel Kontrol Admin Lembaga</h2>
                        <p class="text-muted mb-0">Kelola bidang operasional, pengurus, dan program kerja di bawah lembaga Anda.</p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <div class="d-inline-flex align-items-center gap-2">
                            <span class="badge bg-primary px-3 py-2 rounded-pill fs-6 shadow-sm">
                                <i class="fas fa-calendar-alt me-1"></i> Tahun Aktif: <%= (typeof pengaturan !== 'undefined' && pengaturan.tahun_aktif) ? pengaturan.tahun_aktif : '2026' %>
                            </span>
                            <a href="/logout" class="item-link btn btn-outline-danger btn-sm fw-bold">
                                <i class="fas fa-sign-out-alt me-1"></i> Keluar
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 1. Kartu Statistik Modern (4 Kolom Seimbang) -->
                <div class="row g-4 mb-4">
                    <!-- Card Lembaga Aktif -->
                    <div class="col-md-3">
                        <div class="card p-3 bg-white border-start border-primary border-4">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-primary bg-opacity-10 text-primary fs-4 me-3">
                                    <i class="fas fa-landmark"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Lembaga Aktif</span>
                                    <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 140px;" title="<%= (typeof lembagaData !== 'undefined' && lembagaData) ? lembagaData.nama_organisasi : 'Lembaga' %>">
                                        <%= (typeof lembagaData !== 'undefined' && lembagaData) ? lembagaData.nama_organisasi : 'Lembaga' %>
                                    </h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Jumlah Bidang -->
                    <div class="col-md-3">
                        <div class="card p-3 bg-white border-start border-success border-4">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-success bg-opacity-10 text-success fs-4 me-3">
                                    <i class="fas fa-sitemap"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Total Bidang</span>
                                    <h5 class="fw-bold text-dark mb-0">
                                        <%= (typeof lembagaData !== 'undefined' && lembagaData && lembagaData.Bidangs) ? lembagaData.Bidangs.length : 0 %> Bidang
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Jumlah Pengurus -->
                    <div class="col-md-3">
                        <div class="card p-3 bg-white border-start border-info border-4">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-info bg-opacity-10 text-info fs-4 me-3">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Total Pengurus</span>
                                    <h5 class="fw-bold text-dark mb-0">
                                        <%= (typeof lembagaData !== 'undefined' && lembagaData && lembagaData.Users) ? lembagaData.Users.length : 0 %> Akun
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Total Anggaran Lembaga -->
                    <div class="col-md-3">
                        <div class="card p-3 bg-white border-start border-danger border-4">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-danger bg-opacity-10 text-danger fs-4 me-3">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Total Anggaran</span>
                                    <h5 class="fw-bold text-dark mb-0">
                                        Rp <%= typeof totalAnggaranLembaga !== 'undefined' ? totalAnggaranLembaga.toLocaleString('id-ID') : '0' %>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Matriks Program Kerja & Anggaran (Bulan 1 - 12) - Pindah ke bawah statistik -->
                <div class="card p-4 bg-white mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="fas fa-tasks text-warning me-2"></i> Matriks Program Kerja & Anggaran Lembaga (Bulan 1 - 12)
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0 text-center">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th rowspan="2" class="align-middle py-3" style="width: 4%;">No</th>
                                    <th rowspan="2" class="align-middle py-3 text-start" style="width: 26%;">Nama Program Kerja</th>
                                    <th rowspan="2" class="align-middle py-3" style="width: 15%;">Bidang</th>
                                    <th colspan="12" class="py-2">Bulan Pelaksanaan</th>
                                    <th rowspan="2" class="align-middle py-3" style="width: 10%;">Status</th>
                                    <th rowspan="2" class="align-middle py-3" style="width: 10%;">Aksi</th>
                                </tr>
                                <tr class="small">
                                    <% for(let m = 1; m <= 12; m++) { %>
                                        <th class="py-2" style="width: 3%;"><%= m %></th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof lembagaData !== 'undefined' && lembagaData && lembagaData.Prokers && lembagaData.Prokers.length > 0) { %>
                                    <% lembagaData.Prokers.forEach((proker, index) => { %>
                                        <tr>
                                            <td class="fw-bold text-muted"><%= index + 1 %></td>
                                            <td class="text-start">
                                                <span class="fw-bold text-dark"><%= proker.nama_proker || proker.nama_program || 'Program Kerja' %></span>
                                            </td>
                                            <td>
                                                <span class="text-muted small"><%= proker.Bidang ? proker.Bidang.nama_bidang : '-' %></span>
                                            </td>
                                            
                                            <!-- Looping Check Matriks Bulan 1 s.d 12 -->
                                            <% 
                                                let activeMonths = [];
                                                if (proker.waktu_pelaksanaan) {
                                                    activeMonths = String(proker.waktu_pelaksanaan).split(',').map(item => item.trim());
                                                }
                                            %>
                                            <% for(let m = 1; m <= 12; m++) { %>
                                                <td>
                                                    <% if (activeMonths.includes(String(m))) { %>
                                                        <span class="text-success fw-bold">✔</span>
                                                    <% } else { %>
                                                        <span class="text-muted opacity-25">-</span>
                                                    <% } %>
                                                </td>
                                            <% } %>

                                            <td>
                                                <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                                    <%= proker.status || 'Aktif' %>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="/lembaga-admin/proker/rab/<%= proker.id %>" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye"></i> Kelola
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="17" class="text-center py-4 text-muted">
                                            <i class="fas fa-folder-open fs-3 d-block mb-2 text-secondary opacity-50"></i>
                                            Belum ada Program Kerja terdaftar di lembaga ini.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 3. Bagian Tabel Bawah: Bidang & Pengurus -->
                <div class="row g-4 mb-4">
                    <!-- TABEL DAFTAR BIDANG -->
                    <div class="col-lg-6">
                        <div class="card p-4 bg-white h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="fas fa-sitemap text-primary me-2"></i> Daftar Bidang & Tugas
                                </h5>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th scope="col" style="width: 10%;">No</th>
                                            <th scope="col" style="width: 35%;">Nama Bidang</th>
                                            <th scope="col" style="width: 35%;">Uraian Tugas Singkat</th>
                                            <th scope="col" class="text-center" style="width: 20%;">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof lembagaData !== 'undefined' && lembagaData && lembagaData.Bidangs && lembagaData.Bidangs.length > 0) { %>
                                            <% lembagaData.Bidangs.forEach((bidang, index) => { %>
                                                <tr>
                                                    <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                    <td><span class="fw-bold text-dark"><%= bidang.nama_bidang %></span></td>
                                                    <td>
                                                        <span class="text-muted small" style="display: inline-block; max-width: 160px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= bidang.deskripsi_tugas %>">
                                                            <%= bidang.deskripsi_tugas ? bidang.deskripsi_tugas : '-' %>
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="d-flex justify-content-center gap-1">
                                                            <a href="/lembaga-admin/bidang/edit/<%= bidang.id %>" class="btn btn-outline-warning btn-sm" title="Edit Bidang">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <a href="/lembaga-admin/bidang/hapus/<%= bidang.id %>" class="btn btn-outline-danger btn-sm" title="Hapus Bidang" onclick="return confirm('Yakin ingin menghapus bidang ini?');">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center py-3 text-muted small">Belum ada bidang terdaftar. Gunakan menu sidebar untuk menambah bidang.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- TABEL PENGURUS / USER BIDANG -->
                    <div class="col-lg-6">
                        <div class="card p-4 bg-white h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="fas fa-user-shield text-success me-2"></i> Pengurus / User Bidang
                                </h5>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th scope="col" style="width: 15%;">No</th>
                                            <th scope="col" style="width: 50%;">Nama / Username</th>
                                            <th scope="col" style="width: 35%;">Role</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof lembagaData !== 'undefined' && lembagaData && lembagaData.Users && lembagaData.Users.length > 0) { %>
                                            <% lembagaData.Users.forEach((usr, index) => { %>
                                                <tr>
                                                    <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                    <td>
                                                        <span class="fw-bold text-dark d-block"><%= usr.nama_lengkap %></span>
                                                        <small class="text-muted">@<%= usr.username %></small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary bg-opacity-10 text-dark px-2 py-1">
                                                            <%= usr.role %>
                                                        </span>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center py-3 text-muted small">Belum ada akun pengurus.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
