<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Item Komponen Biaya (RAB)</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Title -->
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Edit Item Komponen Biaya (RAB)</h2>
                    <p class="text-muted mb-0">Ubah uraian, volume, atau harga satuan pada rincian anggaran.</p>
                </div>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="card p-4 bg-white">
                            <form action="/lembaga-admin/proker/rab/edit/<%= itemRAB.id %>" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Uraian / Nama Item Kebutuhan</label>
                                    <input type="text" class="form-control" name="nama_item" value="<%= itemRAB.nama_item %>" required>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold small">Volume / Jumlah</label>
                                        <input type="number" class="form-control" name="jumlah" value="<%= itemRAB.jumlah %>" min="1" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold small">Satuan</label>
                                        <input type="text" class="form-control" name="satuan" value="<%= itemRAB.satuan %>" placeholder="Kotak / Orang / Paket">
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-bold small">Harga Satuan (Rp)</label>
                                    <input type="number" class="form-control" name="harga_satuan" value="<%= itemRAB.harga_satuan %>" min="0" required>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary fw-bold py-2 px-4">
                                        <i class="fas fa-save me-1"></i> Simpan Perubahan
                                    </button>
                                    <a href="/lembaga-admin/proker/rab/<%= itemRAB.prokerId %>" class="btn btn-outline-secondary fw-bold py-2 px-3">Batal</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
