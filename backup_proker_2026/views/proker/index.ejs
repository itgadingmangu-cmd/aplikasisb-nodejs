<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    </style>
</head>
<body class="bg-light">
    <!-- Wrapper utama bersisian -->
    <div class="d-flex">
        
        <!-- Panggil Sidebar di kiri -->
        <%- include('../partials/sidebar') %>
        
        <!-- Area Konten Utama di kanan -->
        <div class="flex-grow-1" style="height: 100vh; overflow-y: auto;">
            <div class="container mt-5 px-4 px-md-5 mb-5">
                
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-0">Manajemen Program Kerja</h2>
                        <p class="text-muted small">Kelola seluruh kegiatan dan progres program kerja lembaga.</p>
                    </div>
                    <a href="/proker/tambah" class="btn btn-primary shadow-sm rounded-3">
                        <i class="fas fa-plus me-2"></i> Tambah Proker
                    </a>
                </div>

                <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                    <div class="alert alert-success shadow-sm"><i class="fas fa-check-circle me-2"></i><%= success_msg %></div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                    <div class="alert alert-danger shadow-sm"><i class="fas fa-exclamation-circle me-2"></i><%= error_msg %></div>
                <% } %>

                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="py-3">No</th>
                                        <th class="py-3">Nama Program</th>
                                        <th class="py-3">Bidang</th>
                                        <th class="py-3">Waktu Pelaksanaan</th>
                                        <th class="py-3">Status</th>
                                        <th class="py-3 text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (prokers && prokers.length > 0) { %>
                                        <% prokers.forEach((proker, index) => { %>
                                            <tr>
                                                <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                <td class="fw-bold"><%= proker.nama_program %></td>
                                                <td>
                                                    <span class="badge bg-light text-primary border border-primary">
                                                        <%= proker.Bidang ? proker.Bidang.nama_bidang : '-' %>
                                                    </span>
                                                </td>
                                                <td><i class="far fa-calendar-alt text-muted me-2"></i> <%= proker.waktu_pelaksanaan %></td>
                                                <td>
                                                    <% if(proker.status === 'Perencanaan') { %>
                                                        <span class="badge bg-secondary rounded-pill px-3"><%= proker.status %></span>
                                                    <% } else if(proker.status === 'Dalam Proses') { %>
                                                        <span class="badge bg-warning text-dark rounded-pill px-3"><%= proker.status %></span>
                                                    <% } else if(proker.status === 'Selesai') { %>
                                                        <span class="badge bg-success rounded-pill px-3"><%= proker.status %></span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger rounded-pill px-3"><%= proker.status %></span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <!-- Tombol Kelola Rincian Anggaran / Biaya -->
                                                    <a href="/proker/<%= proker.id %>/biaya" class="btn btn-sm btn-outline-success rounded-3 me-1" title="Kelola Anggaran Biaya">
                                                        <i class="fas fa-wallet"></i>
                                                    </a>
                                                    <button class="btn btn-sm btn-outline-primary rounded-3 me-1" title="Edit Proker"><i class="fas fa-edit"></i></button>
                                                    <button class="btn btn-sm btn-outline-danger rounded-3" title="Hapus Proker"><i class="fas fa-trash"></i></button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="fas fa-folder-open fs-2 mb-3 d-block opacity-50"></i>
                                                Belum ada data Program Kerja yang ditambahkan.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
        
    </div>
</body>
</html>
