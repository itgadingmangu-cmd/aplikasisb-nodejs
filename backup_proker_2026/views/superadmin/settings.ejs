<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100 p-4">
            
            <div class="mb-4">
                <h2 class="fw-bold">Pengaturan Global Aplikasi</h2>
                <p class="text-muted">Kelola identitas utama aplikasi induk (Nama dan Logo Induk).</p>
            </div>

            <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <div class="row">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <form action="/superadmin/settings" method="POST" enctype="multipart/form-data">
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Nama Aplikasi Induk</label>
                                    <input type="text" name="app_name" class="form-control" value="<%= setting ? setting.app_name : '' %>" required>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Logo Aplikasi Induk</label>
                                    <% if (setting && setting.app_logo) { %>
                                        <div class="mb-2">
                                            <img src="/uploads/logo/<%= setting.app_logo %>" alt="Logo Induk" class="rounded-circle border" style="width: 60px; height: 60px; object-fit: cover;">
                                        </div>
                                    <% } %>
                                    <input type="file" name="logo" class="form-control" accept="image/*">
                                    <div class="form-text">Format yang didukung: JPG, PNG. Kosongkan jika tidak ingin mengubah logo.</div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 fw-bold">
                                    <i class="fas fa-save me-1"></i> Simpan Perubahan
                                </button>

                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
