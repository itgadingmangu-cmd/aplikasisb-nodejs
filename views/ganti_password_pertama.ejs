<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Ganti Password Akun' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Pembaruan Password Akun</h2>
                        <p class="text-muted mb-0">Disarankan mengganti password awal Anda dengan password yang lebih kuat untuk menjaga keamanan akun.</p>
                    </div>
                    <div>
                        <a href="<%= (userSession && userSession.role === 'superadmin') ? '/' : '/lembaga-admin' %>" class="btn btn-outline-secondary btn-sm fw-bold px-3 py-2">
                            <i class="fas fa-arrow-right me-1"></i> Nanti Saja / Ke Dashboard
                        </a>
                    </div>
                </div>

                <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="card p-4 bg-white">
                            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-key text-primary me-2"></i> Ganti Password</h5>
                            <form action="/ganti-password-wajib" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Password Saat Ini</label>
                                    <input type="password" name="password_lama" class="form-control" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Password Baru</label>
                                    <input type="password" name="password_baru" class="form-control" required>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-bold small">Konfirmasi Password Baru</label>
                                    <input type="password" name="konfirmasi_password" class="form-control" required>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="submit" class="btn btn-primary fw-bold px-4 py-2">
                                        <i class="fas fa-shield-check me-1"></i> Simpan Password Kuat
                                    </button>
                                    <a href="<%= (userSession && userSession.role === 'superadmin') ? '/' : '/lembaga-admin' %>" class="btn btn-light border fw-semibold px-4 py-2">
                                        Lewati Sementara
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card p-4 bg-white h-100">
                            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-list-check text-success me-2"></i> Kriteria Password Kuat</h5>
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Minimal <strong>8 karakter</strong></li>
                                <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Mengandung minimal <strong>1 huruf besar</strong> (A-Z)</li>
                                <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Mengandung minimal <strong>1 huruf kecil</strong> (a-z)</li>
                                <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Mengandung minimal <strong>1 angka</strong> (0-9)</li>
                                <li class="list-group-item px-0"><i class="fas fa-check text-success me-2"></i> Berbeda dari password sebelumnya</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
