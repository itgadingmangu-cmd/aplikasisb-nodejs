<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Rincian Anggaran (RAB) Program Kerja</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Title (Clean Header) -->
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Rincian Anggaran Biaya (RAB)</h2>
                    <p class="text-muted mb-0">Program Kerja: <strong class="text-primary"><%= proker.nama_program %></strong></p>
                </div>

                <!-- Info Ringkas Proker -->
                <div class="alert alert-primary bg-primary bg-opacity-10 border-0 text-dark mb-4 p-3 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <span class="d-block small text-muted">Bulan Pelaksanaan (Checkbox): <strong><%= proker.waktu_pelaksanaan ? 'Bulan ke: ' + proker.waktu_pelaksanaan : '-' %></strong> | Status: <strong><%= proker.status %></strong></span>
                        <span>Deskripsi: <%= proker.deskripsi || 'Tidak ada deskripsi' %></span>
                    </div>
                    <div class="text-start text-md-end w-100 w-md-auto border-top border-primary border-opacity-25 pt-2 pt-md-0">
                        <span class="d-block small text-muted">Akumulasi Total RAB:</span>
                        <h4 class="fw-bold text-success mb-0">
                            Rp <%= (proker.RincianBiayas ? proker.RincianBiayas.reduce((s, i) => s + (parseFloat(i.total) || 0), 0) : 0).toLocaleString('id-ID') %>
                        </h4>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Form Tambah Item RAB (Kolom Kiri) - Tanpa Pilih Bulan Manual -->
                    <div class="col-lg-4">
                        <div class="card p-4 bg-white">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="fas fa-plus-circle text-primary me-2"></i> Tambah Item Komponen Biaya
                            </h5>
                            <form action="/lembaga-admin/proker/rab/tambah/<%= proker.id %>" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Uraian / Nama Item Kebutuhan</label>
                                    <input type="text" class="form-control" name="nama_item" placeholder="Contoh: Konsumsi Rapat Koordinasi" required>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold small">Volume / Jumlah</label>
                                        <input type="number" class="form-control" name="jumlah" placeholder="Contoh: 3" min="1" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold small">Satuan</label>
                                        <input type="text" class="form-control" name="satuan" placeholder="Kotak / Orang / Paket">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Harga Satuan (Rp)</label>
                                    <input type="number" class="form-control" name="harga_satuan" placeholder="Contoh: 25000" min="0" required>
                                </div>
                                
                                <!-- Info Otomatis Bulan dari Checkbox Proker -->
                                <div class="alert alert-info py-2 px-3 small mb-4">
                                    <i class="fas fa-info-circle me-1"></i> Alokasi bulan dihitung otomatis berdasarkan centang bulan pada Program Kerja (Total bulan aktif: 
                                    <strong>
                                        <% 
                                            let countBulan = 1;
                                            if (proker.waktu_pelaksanaan) {
                                                let arrB = proker.waktu_pelaksanaan.split(',').filter(Boolean);
                                                if (arrB.length > 0) countBulan = arrB.length;
                                            }
                                        %>
                                        <%= countBulan %> Bulan
                                    </strong>).
                                </div>

                                <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                    <i class="fas fa-save me-1"></i> Simpan Item Biaya
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Tabel Daftar Item RAB (Kolom Kanan) -->
                    <div class="col-lg-8">
                        <div class="card p-4 bg-white h-100">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="fas fa-calculator text-success me-2"></i> Rincian Komponen Biaya (RAB)
                            </h5>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th>No</th>
                                            <th>Uraian Item</th>
                                            <th>Vol / Satuan</th>
                                            <th>Harga Satuan</th>
                                            <th>Durasi (Bulan)</th>
                                            <th class="text-end">Total</th>
                                            <th class="text-center">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (proker.RincianBiayas && proker.RincianBiayas.length > 0) { %>
                                            <% proker.RincianBiayas.forEach((item, index) => { %>
                                                <tr>
                                                    <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                    <td><span class="fw-bold text-dark"><%= item.nama_item %></span></td>
                                                    <td><%= item.jumlah %> <%= item.satuan %></td>
                                                    <td>Rp <%= item.harga_satuan.toLocaleString('id-ID') %></td>
                                                    <td><span class="badge bg-light text-dark border"><%= item.bulan %> Bulan</span></td>
                                                    <td class="text-end fw-bold text-success">
                                                        Rp <%= item.total.toLocaleString('id-ID') %>
                                                    </td>
                                                    <td class="text-center">
    <div class="d-flex justify-content-center gap-1">
        <!-- Tombol Edit Item RAB -->
        <a href="/lembaga-admin/proker/rab/edit/<%= item.id %>" class="btn btn-outline-warning btn-sm" title="Edit Item">
            <i class="fas fa-edit"></i>
        </a>
        <!-- Tombol Hapus Item RAB -->
        <a href="/lembaga-admin/proker/rab/hapus/<%= item.id %>" class="btn btn-outline-danger btn-sm" title="Hapus Item" onclick="return confirm('Yakin ingin menghapus item biaya ini?');">
            <i class="fas fa-trash-alt"></i>
        </a>
    </div>
</td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted small">Belum ada rincian komponen biaya yang dientri.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
