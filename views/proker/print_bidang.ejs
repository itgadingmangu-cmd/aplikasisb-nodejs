<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #fff; font-family: 'Times New Roman', Times, serif; color: #000; }
        .sheet { padding: 20mm; }
        @media print {
            .no-print { display: none !important; }
            body { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="container sheet">
        <!-- Tombol Aksi Cetak (Hilang saat diprint) -->
        <div class="text-end mb-4 no-print">
            <button onclick="window.print()" class="btn btn-primary btn-sm fw-bold">
                <i class="fas fa-print me-1"></i> Cetak Dokumen / PDF
            </button>
            <a href="javascript:history.back()" class="btn btn-secondary btn-sm">Kembali</a>
        </div>

        <!-- Kop Surat / Header Laporan Bidang -->
        <div class="text-center border-bottom pb-3 mb-4">
            <h4 class="fw-bold text-uppercase mb-1">REKAPITULASI PROGRAM KERJA & ANGGARAN</h4>
            <h5 class="fw-bold text-uppercase text-secondary">BIDANG: <%= bidang.nama_bidang %></h5>
            <p class="text-muted mb-0 small">Tahun Anggaran: <%= bidang.tahun %></p>
        </div>

        <!-- Tabel Daftar Program Kerja Terkelompok (Reguler & Insidentil) -->
        <table class="table table-bordered align-middle">
            <thead class="table-light text-center">
                <tr>
                    <th style="width: 5%;">No</th>
                    <th style="width: 35%;">Nama Program Kerja / Kegiatan</th>
                    <th style="width: 20%;">Waktu Pelaksanaan</th>
                    <th style="width: 15%;">Status</th>
                    <th style="width: 25%;">Total Anggaran (RAB)</th>
                </tr>
            </thead>
            <tbody>
                <% if (bidang.Prokers && bidang.Prokers.length > 0) { %>
                    <% 
                        // Pisahkan proker menjadi Reguler dan Insidentil secara aman
                        const prokerReguler = bidang.Prokers.filter(p => !p.jenis || p.jenis === 'Reguler');
                        const prokerInsidentil = bidang.Prokers.filter(p => p.jenis === 'Insidentil');
                        
                        let nomorGlobal = 1;
                        let totalRegulerRAB = 0;
                        let totalInsidentilRAB = 0;
                    %>

                    <!-- KELOMPOK 1: PROKER REGULER (SESUAI RAB) -->
                    <tr class="table-secondary fw-bold">
                        <td colspan="5"><i class="fas fa-circle-check text-success me-1"></i> I. PROGRAM KERJA REGULER (SESUAI RAB UTAMA)</td>
                    </tr>
                    <% if (prokerReguler.length > 0) { %>
                        <% prokerReguler.forEach((proker) => { %>
                            <% totalRegulerRAB += Number(proker.anggaran || 0); %>
                            <tr>
                                <td class="text-center"><%= nomorGlobal++ %></td>
                                <td class="fw-semibold"><%= proker.nama_program %></td>
                                <td class="text-center"><%= proker.waktu_pelaksanaan || '-' %></td>
                                <td class="text-center"><span class="badge bg-secondary"><%= proker.status %></span></td>
                                <td class="text-end">Rp <%= Number(proker.anggaran || 0).toLocaleString('id-ID') %></td>
                            </tr>
                        <% }) %>
                        <tr class="fw-bold bg-light">
                            <td colspan="4" class="text-end text-muted">Subtotal Anggaran Reguler:</td>
                            <td class="text-end">Rp <%= totalRegulerRAB.toLocaleString('id-ID') %></td>
                        </tr>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted fst-italic py-2">Tidak ada program kerja reguler di bidang ini.</td>
                        </tr>
                    <% } %>

                    <!-- KELOMPOK 2: KEGIATAN INSIDENTIL (DI LUAR RAB) -->
                    <tr class="table-secondary fw-bold">
                        <td colspan="5"><i class="fas fa-triangle-exclamation text-warning me-1"></i> II. KEGIATAN INSIDENTIL (DI LUAR RAB / TAMBAHAN)</td>
                    </tr>
                    <% if (prokerInsidentil.length > 0) { %>
                        <% prokerInsidentil.forEach((proker) => { %>
                            <% totalInsidentilRAB += Number(proker.anggaran || 0); %>
                            <tr>
                                <td class="text-center"><%= nomorGlobal++ %></td>
                                <td class="fw-semibold"><%= proker.nama_program %> <span class="badge bg-warning text-dark ms-1" style="font-size: 10px;">Insidentil</span></td>
                                <td class="text-center"><%= proker.waktu_pelaksanaan || '-' %></td>
                                <td class="text-center"><span class="badge bg-secondary"><%= proker.status %></span></td>
                                <td class="text-end">Rp <%= Number(proker.anggaran || 0).toLocaleString('id-ID') %></td>
                            </tr>
                        <% }) %>
                        <tr class="fw-bold bg-light">
                            <td colspan="4" class="text-end text-muted">Subtotal Anggaran Insidentil:</td>
                            <td class="text-end">Rp <%= totalInsidentilRAB.toLocaleString('id-ID') %></td>
                        </tr>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted fst-italic py-2">Tidak ada kegiatan insidentil / di luar RAB.</td>
                        </tr>
                    <% } %>

                    <!-- TOTAL KESELURUHAN KONSOLIDASI -->
                    <% var totalSemuaRAB = totalRegulerRAB + totalInsidentilRAB; %>
                    <tr class="table-dark fw-bold text-uppercase">
                        <td colspan="4" class="text-end">Total Keseluruhan Anggaran Bidang (Reguler + Insidentil):</td>
                        <td class="text-end text-warning">Rp <%= totalSemuaRAB.toLocaleString('id-ID') %></td>
                    </tr>

                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center text-muted py-3">Belum ada program kerja yang terdaftar di bidang ini.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- Bagian Tanda Tangan / Pengesahan -->
        <div class="row mt-5 pt-4 text-center">
            <div class="col-6">
                <p class="mb-1">Mengetahui,</p>
                <p class="fw-bold mb-5">Ketua Bidang <%= bidang.nama_bidang %></p>
                <br><br>
                <p class="fw-bold text-decoration-underline mb-0">( _____________________ )</p>
            </div>
            <div class="col-6">
                <p class="mb-1">Disahkan Oleh,</p>
                <p class="fw-bold mb-5">Ketua Lembaga</p>
                <br><br>
                <p class="fw-bold text-decoration-underline mb-0"><%= lembaga.nama_ketua || 'Pimpinan Lembaga' %></p>
            </div>
        </div>
    </div>
</body>
</html>
