<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Rekapitulasi Global Tahunan - <%= lembaga.nama_organisasi %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #ffffff; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.5; }
        .sheet { width: 210mm; min-height: 297mm; padding: 15mm 15mm; margin: 10mm auto; background: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        @media print {
            body { background: none; }
            .sheet { width: 100%; margin: 0; padding: 10mm; box-shadow: none; }
            .no-print { display: none !important; }
        }
        .signature-box { min-height: 65px; display: flex; align-items: center; justify-content: center; position: relative; }
    </style>
</head>
<body>

    <!-- Tombol Cetak / Kembali (Hilang Saat Diprint) -->
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4 me-2">
            <i class="fas fa-print me-1"></i> Cetak / Simpan PDF Rekap Global
        </button>
        <a href="/lembaga-admin/rekap-global" class="btn btn-outline-secondary fw-bold px-4">
            Kembali ke Pengaturan
        </a>
    </div>

    <% 
        // Fungsi helper untuk merapikan format huruf kapital di setiap awal kata (Title Case)
        function toTitleCase(str) {
            if (!str) return '';
            return str.toLowerCase().split(' ').map(word => {
                return word.charAt(0).toUpperCase() + word.slice(1);
            }).join(' ');
        }
    %>

    <div class="sheet">
        <!-- KOP SURAT LEMBAGA (DIPERLEBAR & DISESUAIKAN) -->
        <div class="text-center mb-4 border-bottom pb-3 w-100">
            <% if (lembaga.kop_surat) { %>
                <img src="/uploads/logo/<%= lembaga.kop_surat %>" alt="Kop Surat" class="w-100" style="max-height: 170px; object-fit: contain;">
            <% } else { %>
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <% if (lembaga.logo) { %>
                        <img src="/uploads/logo/<%= lembaga.logo %>" alt="Logo" style="max-height: 90px; width: auto; object-fit: contain;">
                    <% } %>
                    <div>
                        <h3 class="fw-bold text-uppercase mb-1"><%= lembaga.nama_organisasi %></h3>
                        <p class="mb-0 small"><%= lembaga.alamat || 'Alamat Sekretariat Lembaga' %> | Telp: <%= lembaga.nomor_hp || '-' %></p>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- JUDUL LAPORAN -->
        <div class="text-center my-4">
            <h4 class="fw-bold text-uppercase">REKAPITULASI <br>PROGRAM KERJA & ANGGARAN (RAB)</h4>
            <h5 class="fw-bold text-uppercase text-secondary"><%= lembaga.nama_organisasi %> Tahun <%= typeof pengaturan !== 'undefined' ? pengaturan.tahun_aktif : '2026' %></h5>
        </div>

        <!-- TABEL REKAPITULASI PROGRAM KERJA & RAB -->
        <div class="mb-4">
            <table class="table table-bordered table-sm align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 5%;">No</th>
                        <th>Nama Program Kerja</th>
                        <th style="width: 18%;">Bidang</th>
                        <th style="width: 22%;">Waktu Pelaksanaan</th>
                        <th style="width: 22%;">Nominal Anggaran (RAB)</th>
                    </tr>
                </thead>
                <tbody>
                    <% 
                        const namaBulanList = ["", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                        let totalGlobal = 0; 
                    %>
                    <% if (listProker && listProker.length > 0) { %>
                        <% listProker.forEach((proker, index) => { %>
                            <% 
                                totalGlobal += (Number(proker.anggaran) || 0); 
                                
                                // Format waktu pelaksanaan dari angka (misal: "2,11") menjadi nama bulan (Februari, November)
                                let rawBulan = String(proker.waktu_pelaksanaan || '');
                                let arrBulan = rawBulan.split(',').map(b => parseInt(b.trim())).filter(Boolean);
                                let formattedBulan = arrBulan.length > 0 ? arrBulan.map(b => namaBulanList[b] || b).join(', ') : '-';
                            %>
                            <tr>
                                <td class="text-center"><%= index + 1 %></td>
                                <td><%= proker.nama_program %></td>
                                <td class="text-center"><%= proker.Bidang ? proker.Bidang.nama_bidang : '-' %></td>
                                <td class="text-center"><%= formattedBulan %></td>
                                <td class="text-end">Rp <%= proker.anggaran ? Number(proker.anggaran).toLocaleString('id-ID') : '0' %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted">Belum ada program kerja terdaftar.</td>
                        </tr>
                    <% } %>
                </tbody>
                <tfoot>
                    <tr class="table-light fw-bold">
                        <td colspan="4" class="text-end">TOTAL KESELURUHAN ANGGARAN TAHUNAN:</td>
                        <td class="text-end text-danger">Rp <%= Number(totalGlobal).toLocaleString('id-ID') %></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- LEMBAR TANDA TANGAN GLOBAL -->
        <% 
            let showStempel       = Boolean(lembaga.print_stempel);
            let showTtdKetuaImg   = Boolean(lembaga.print_ttd_ketua_img);
            let showTtdPembinaImg = Boolean(lembaga.print_ttd_pembina_img);
            let showKetua         = Boolean(lembaga.print_ketua);
            let showPengaju       = Boolean(lembaga.print_pengaju);
            let showPembina       = Boolean(lembaga.print_pembina);
        %>

        <div class="mt-5 pt-3">
            <!-- Baris Tanggal Cetak -->
            <div class="row text-center mb-1">
                <div class="col-6"></div>
                <div class="col-6">
                    <% 
                        const bulanIndo = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                        let tglSkrg = new Date();
                        let tanggalCetak = tglSkrg.getDate() + " " + bulanIndo[tglSkrg.getMonth()] + " " + tglSkrg.getFullYear();
                    %>
                    <p class="mb-0">Jombang, <%= tanggalCetak %></p>
                </div>
            </div>
            
            <div class="row text-center">
                
                <!-- 1. Ketua Lembaga -->
                <% if (showKetua) { %>
                    <div class="col-6 mb-4 position-relative">
                        <p class="mb-1">Mengetahui / Mengesahkan,</p>
                        <p class="fw-bold mb-2">Ketua <%= toTitleCase(lembaga.nama_organisasi) %></p>
                        
                        <!-- Stempel Lembaga -->
                        <% if (showStempel && lembaga.stempel) { %>
                            <div style="position: absolute; left: 25%; transform: translateX(-50%); bottom: 75px; opacity: 0.85; pointer-events: none; z-index: 2;">
                                <img src="/uploads/logo/<%= lembaga.stempel %>" alt="Stempel Lembaga" style="width: 15px; height: 100px; object-fit: cover;">
                            </div>
                        <% } %>

                        <div class="signature-box mb-2">
                            <% if (showTtdKetuaImg && lembaga.ttd_ketua) { %>
                                <img src="/uploads/logo/<%= lembaga.ttd_ketua %>" alt="TTD Ketua" style="max-height: 90px; object-fit: contain; position: relative; z-index: 1;">
                            <% } %>
                        </div>
                        <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.nama_ketua || 'Pimpinan Lembaga' %></p>
                    </div>
                <% } else { %>
                    <div class="col-6 mb-4"></div>
                <% } %>

                <!-- 2. Pembina Senkom Jombang -->
                <% if (showPengaju) { %>
                    <div class="col-6 mb-4">
                        <p class="mb-1">Mengetahui,</p>
                        <p class="fw-bold mb-2">Pembina <%= toTitleCase(lembaga.nama_organisasi) %></p>
                        
                        <div class="signature-box mb-2">
                            <% if (showTtdPembinaImg && lembaga.ttd_pembina_senkom) { %>
                                <img src="/uploads/logo/<%= lembaga.ttd_pembina_senkom %>" alt="TTD Pembina Senkom" style="max-height: 90px; object-fit: contain;">
                            <% } %>
                        </div>
                        <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.pembina_senkom || 'Pembina Senkom' %></p>
                    </div>
                <% } else { %>
                    <div class="col-6 mb-4"></div>
                <% } %>

                <!-- 3. Slot 6 Pembina Wilayah / Dewan Penasihat -->
                <% if (showPembina) { %>
                    <% 
                        let pembinaList = [
                            { nama: lembaga.pembina_1, wilayah: 'Pembina Jombang Kota' },
                            { nama: lembaga.pembina_2, wilayah: 'Pembina Jombang Barat' },
                            { nama: lembaga.pembina_3, wilayah: 'Pembina Jombang Timur' },
                            { nama: lembaga.pembina_4, wilayah: 'Pembina Jombang Utara' },
                            { nama: lembaga.pembina_5, wilayah: 'Pembina Jombang Selatan' },
                            { nama: lembaga.pembina_6, wilayah: 'Pembina Muhajir Gadingmangu' }
                        ].filter(p => p.nama && p.nama.trim() !== '');
                    %>

                    <% if (pembinaList.length > 0) { %>
                        <div class="col-12 mt-3 mb-2"><hr><p class="fw-bold big mb-8 text-uppercase ">Dewan Pembina</p></div>
                        <% pembinaList.forEach((pembina) => { %>
                            <div class="col-4 mb-10">
                                <p class="mb-15 big"><%= pembina.wilayah %></p>
                                <div class="signature-box mb-8" style="min-height: 95px;"></div>
                                <p class="fw-bold big mb-8 text-decoration-underline"><%= pembina.nama %></p>
                            </div>
                        <% }) %>
                    <% } %>
                <% } %>

            </div>
        </div>

    </div>

</body>
</html>
