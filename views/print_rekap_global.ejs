<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Rekap Global & RAB - <%= lembaga.nama_organisasi %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #ffffff; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.4; }
        .sheet { width: 210mm; min-height: 297mm; padding: 15mm; margin: 10mm auto; background: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); position: relative; overflow: hidden; }
        
        /* ATURAN BARU KETAT: Menghapus header & footer bawaan browser (URL, Tanggal, dll) */
        @page {
            size: A4 portrait;
            margin: 0; 
        }

        @media print {
            body { background: none; }
            /* Padding disesuaikan menjadi 15mm agar konten tidak mepet ujung kertas karena margin halaman dijadikan 0 */
            .sheet { width: 100%; margin: 0; padding: 15mm; box-shadow: none; overflow: visible; }
            .no-print { display: none !important; }
            
            /* Watermark otomatis hilang saat dokumen dicetak ke PDF (Versi Final) */
            .hide-watermark-on-print { display: none !important; }
        }
        
        .signature-box { min-height: 110px; position: relative; display: flex; align-items: center; justify-content: center; }
        
        /* Styling Matriks Bulan */
        .table-matrix th, .table-matrix td {
            font-size: 0.7rem;
            padding: 2px 1px;
            text-align: center;
            vertical-align: middle;
        }

        /* Styling Watermark DRAFT */
        .watermark-draft {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 8.5rem;
            color: rgba(220, 53, 69, 0.08); /* Warna merah super transparan */
            z-index: 0;
            pointer-events: none;
            font-weight: bold;
            text-transform: uppercase;
            white-space: nowrap;
            user-select: none;
        }
        /* Mengangkat konten asli agar tetap bisa diklik/diblok di atas watermark */
        .content-wrapper { position: relative; z-index: 1; }
        /* ATURAN KETAT: Mencegah blok tanda tangan terpotong ke halaman berikutnya */
        .page-break-safe {
            page-break-inside: avoid;
            break-inside: avoid;
        }        
    </style>
</head>
<body>

    <!-- Tombol Cetak / Kembali (Hilang Saat Diprint) -->
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4 me-2">
            <i class="fas fa-print me-1"></i> Cetak / Simpan PDF
        </button>
        <!-- Tombol Baru Pengontrol Draft -->
        <button onclick="toggleDraft()" class="btn btn-outline-danger fw-bold px-4 me-2">
            <i class="fas fa-eye-slash me-1"></i> Tampilan Draft / Bersih
        </button>
        <a href="/lembaga-admin/rekap-global" class="btn btn-outline-secondary fw-bold px-4">
            Kembali ke Pengaturan
        </a>
    </div>

    <div class="sheet">
        <!-- Elemen Watermark Latar Belakang -->
        <div id="watermarkElement" class="watermark-draft hide-watermark-on-print">DRAFT REKAP</div>

        <!-- Pembungkus Konten Asli (Agar berada di atas watermark) -->
        <div class="content-wrapper">

            <!-- KOP SURAT LEMBAGA -->
            <div class="text-center mb-4 border-bottom pb-3">
                <% if (lembaga.kop_surat) { %>
                    <img src="/uploads/logo/<%= lembaga.kop_surat %>" alt="Kop Surat" class="img-fluid" style="max-height: 170px; object-fit: contain;">
                <% } else { %>
                    <h3 class="fw-bold text-uppercase"><%= lembaga.nama_organisasi %></h3>
                    <p class="mb-0 small"><%= lembaga.alamat || 'Alamat Sekretariat Lembaga' %> | Telp: <%= lembaga.nomor_hp || '-' %></p>
                <% } %>
            </div>

            <!-- JUDUL LAPORAN -->
            <div class="text-center my-3">
                <h4 class="fw-bold text-uppercase">REKAPITULASI PROGRAM KERJA & ANGGARAN</h4>
                <h5 class="fw-bold text-uppercase text-secondary"><%= lembaga.nama_organisasi %> TAHUN <%= (typeof tahunAktif !== 'undefined' && tahunAktif) ? tahunAktif : (typeof tahun !== 'undefined' ? tahun : '2026') %></h5>
            </div>

            <!-- TABEL REKAP GLOBAL -->
            <div class="mb-4">
                <table class="table table-bordered table-sm align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th rowspan="2" style="width: 5%; vertical-align: middle;">No</th>
                            <th rowspan="2" style="width: 30%; vertical-align: middle;">Nama Program Kerja</th>
                            <th rowspan="2" style="width: 15%; vertical-align: middle;">Bidang</th>
                            <th colspan="12" style="width: 30%;">Waktu Pelaksanaan (Bulan)</th>
                            <th rowspan="2" style="width: 20%; vertical-align: middle;">Nominal Anggaran (RAB)</th>
                        </tr>
                        <tr>
                            <th style="width: 2.5%;">1</th><th style="width: 2.5%;">2</th><th style="width: 2.5%;">3</th>
                            <th style="width: 2.5%;">4</th><th style="width: 2.5%;">5</th><th style="width: 2.5%;">6</th>
                            <th style="width: 2.5%;">7</th><th style="width: 2.5%;">8</th><th style="width: 2.5%;">9</th>
                            <th style="width: 2.5%;">10</th><th style="width: 2.5%;">11</th><th style="width: 2.5%;">12</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                            let totalGlobalAnggaran = 0;
                            let listProker = (typeof prokers !== 'undefined' && prokers) ? prokers : [];
                        %>

                        <% if (listProker.length > 0) { %>
                            <% listProker.forEach((proker, index) => { %>
                                <% 
                                    let anggaran = proker.anggaran || 0;
                                    totalGlobalAnggaran += Number(anggaran);

                                    // Parsing bulan pelaksanaan (misal: "1, 2, 11")
                                    let rawBulan = String(proker.waktu_pelaksanaan || '');
                                    let bulanArr = rawBulan.split(',').map(b => parseInt(b.trim())).filter(Boolean);
                                %>
                                <tr>
                                    <td class="text-center"><%= index + 1 %></td>
                                    <td><%= proker.nama_program %></td>
                                    <td class="text-center"><%= (proker.Bidang && proker.Bidang.nama_bidang) ? proker.Bidang.nama_bidang : '-' %></td>
                                    
                                    <!-- Matriks 12 Bulan -->
                                    <% for(let m=1; m<=12; m++) { %>
                                        <td class="text-center fw-bold text-success">
                                            <%= bulanArr.includes(m) ? '✓' : '' %>
                                        </td>
                                    <% } %>

                                    <td class="text-end">Rp <%= Number(anggaran).toLocaleString('id-ID') %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="16" class="text-center text-muted">Belum ada data program kerja untuk tahun ini.</td>
                            </tr>
                        <% } %>
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="15" class="text-end">TOTAL KESELURUHAN ANGGARAN TAHUNAN:</td>
                            <td class="text-end text-danger">Rp <%= Number(totalGlobalAnggaran).toLocaleString('id-ID') %></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- LEMBAR TANDA TANGAN -->
            <% 
                let showStempel        = Boolean(lembaga.print_stempel);
                let showTtdKetuaImg    = Boolean(lembaga.print_ttd_ketua_img);
                let showTtdPembinaImg  = Boolean(lembaga.print_ttd_pembina_img);
                let showKetua          = Boolean(lembaga.print_ketua);
                
                // Variabel yang sudah diperbaiki
                let showPembinaLembaga = Boolean(lembaga.print_pembina);         // Murni untuk 1 Pembina (H. Abu Bakar)
                let show6Pembina       = Boolean(lembaga.print_pembina_lembaga); // Murni untuk 6 Dewan Pembina

                function toTitleCase(str) {
                    if (!str) return '';
                    return str.toLowerCase().split(' ').map(word => {
                        return word.charAt(0).toUpperCase() + word.slice(1);
                    }).join(' ');
                }
            %>

            <div class="mt-4 pt-2 page-break-safe">
                <!-- Baris Tanggal -->
                <div class="row text-center mb-1">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <% 
                            const bulanIndo = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                            let tglSkrg = new Date();
                            let tanggalCetak = tglSkrg.getDate() + " " + bulanIndo[tglSkrg.getMonth()] + " " + tglSkrg.getFullYear();
                        %>
                        <p class="mb-0">Jombang, <%= tanggalCetak %></p>
                    </div>
                </div>

                <!-- BARIS PERTAMA: Kolom Ketua (Kiri) dan Pembina Lembaga (Kanan) -->
                <div class="row text-center">
                    <!-- 1. Kolom Ketua Lembaga & Stempel (Di KIRI) -->
                    <% if (showKetua) { %>
                        <div class="col-6 mb-4 position-relative">
                            <p class="mb-1">Mengetahui,</p>
                            <p class="fw-bold mb-2">Ketua <%= toTitleCase(lembaga.nama_organisasi) %></p>
                            
                            <div class="signature-box mb-2" style="min-height: 95px;">
                                <!-- Stempel Digital Terisolasi -->
                                <% if (showStempel && lembaga.stempel) { %>
                                    <div style="position: absolute; left: 22%; transform: translateX(-50%); top: 5px; opacity: 0.85; pointer-events: none; z-index: 2;">
                                        <img src="/uploads/logo/<%= lembaga.stempel %>" alt="Stempel Lembaga" style="width: 210px; height: 100px; object-fit: contain;">
                                    </div>
                                <% } %>

                                <% if (showTtdKetuaImg && lembaga.ttd_ketua) { %>
                                    <img src="/uploads/logo/<%= lembaga.ttd_ketua %>" alt="TTD Ketua" style="max-height: 95px; width: auto; object-fit: contain; position: relative; z-index: 1;">
                                <% } %>
                            </div>

                            <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.nama_ketua || 'Agus Efendy' %></p>
                        </div>
                    <% } else { %>
                        <div class="col-6 mb-4"></div>
                    <% } %>

                <!-- 2. Kolom Pembina Lembaga (Di KANAN) -->
                    <% if (showPembinaLembaga) { %>
                        <div class="col-6 mb-4">
                            <p class="mb-1">Mengesahkan / Menyetujui,</p>
                            <p class="fw-bold mb-2">Pembina <%= toTitleCase(lembaga.nama_organisasi) %></p>
                            
                            <div class="signature-box mb-2" style="min-height: 95px;">
                                <% if (showTtdPembinaImg && lembaga.ttd_pembina_senkom) { %>
                                    <img src="/uploads/logo/<%= lembaga.ttd_pembina_senkom %>" alt="TTD Pembina" style="max-height: 95px; object-fit: contain;">
                                <% } %>
                            </div>
                            <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.pembina_senkom %></p>
                        </div>
                    <% } else { %>
                        <div class="col-6 mb-4"></div>
                    <% } %>
                </div> <!-- PENUTUP ROW BARIS PERTAMA -->

                <!-- 3. BARIS KEDUA: Slot 6 Pembina Wilayah / Dewan Penasihat -->
                <% if (lembaga.print_pembina == true || lembaga.print_pembina == 1 || lembaga.print_pembina == '1') { %>
                    <% 
                        let pembinaList = [
                            { nama: lembaga.pembina_1, wilayah: 'Pembina Jombang Kota' },
                            { nama: lembaga.pembina_2, wilayah: 'Pembina Jombang Barat' },
                            { nama: lembaga.pembina_3, wilayah: 'Pembina Jombang Timur' },
                            { nama: lembaga.pembina_4, wilayah: 'Pembina Jombang Utara' },
                            { nama: lembaga.pembina_5, wilayah: 'Pembina Jombang Selatan' },
                            { nama: lembaga.pembina_6, wilayah: 'Pembina Muhajir Gadingmangu' }
                        ].filter(p => p.nama && p.nama.trim() !== '');
                    %>

                    <% if (pembinaList.length > 0) { %>
                        <div class="row text-center mt-3">
                            <div class="col-12 mb-3"><hr><p class="fw-bold big mb-2 text-uppercase">Dewan Pembina</p></div>
                            <% pembinaList.forEach((pembina) => { %>
                                <div class="col-4 mb-4">
                                    <p class="mb-2 big"><%= pembina.wilayah %></p>
                                    <div class="signature-box mb-2" style="min-height: 95px;"></div>
                                    <p class="fw-bold big mb-2 text-decoration-underline"><%= pembina.nama %></p>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                <% } %>
            </div> <!-- Penutup mt-4 pt-2 -->
            
        </div> <!-- PENUTUP CONTENT WRAPPER -->
    </div> <!-- PENUTUP SHEET -->

    <!-- Script Fungsi Tombol Draft -->
    <script>
        function toggleDraft() {
            const wm = document.getElementById('watermarkElement');
            if (wm.style.display === 'none') {
                wm.style.display = 'block';
            } else {
                wm.style.display = 'none';
            }
        }
    </script>
</body>
</html>
