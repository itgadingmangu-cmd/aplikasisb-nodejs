<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Proposal - <%= proker.nama_program %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.6; }
        .sheet { width: 210mm; min-height: 297mm; padding: 20mm; margin: 10mm auto; background: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); position: relative; overflow: hidden; }
        
        @media print {
            body { background: none; }
            .sheet { width: 100%; margin: 0; padding: 10mm; box-shadow: none; overflow: visible; }
            .no-print { display: none !important; }
            .watermark-draft { display: none !important; } /* Wajib hilang saat diprint resmi */
        }
        
        .signature-box { min-height: 105px; position: relative; display: flex; align-items: center; justify-content: center; }
        
        /* Styling Watermark Draft yang pasti tampil */
        .watermark-draft {
            position: absolute !important;
            top: 45% !important;
            left: 50% !important;
            transform: translate(-50%, -50%) rotate(-30deg) !important;
            font-size: 5rem !important;
            font-weight: 900 !important;
            color: rgba(220, 53, 69, 0.18) !important;
            text-transform: uppercase !important;
            z-index: 99999 !important;
            pointer-events: none !important;
            user-select: none !important;
            white-space: nowrap !important;
            letter-spacing: 8px !important;
        }
    </style>
</head>
<body>

    <!-- Tombol Cetak / Kembali (Hilang Saat Diprint) -->
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4 me-2">
            <i class="fas fa-print me-1"></i> Cetak / Simpan PDF
        </button>
        <a href="/lembaga-admin/proker/proposal/<%= proker.id %>" class="btn btn-outline-secondary fw-bold px-4">
            Kembali ke Editor
        </a>
    </div>

    <div class="sheet">
        <!-- Container Watermark -->
        <div id="watermarkContainer"></div>

        <!-- KOP SURAT LEMBAGA -->
        <div class="text-center mb-4 border-bottom pb-3">
            <% if (lembaga.kop_surat) { %>
                <img src="/uploads/logo/<%= lembaga.kop_surat %>" alt="Kop Surat" class="img-fluid" style="max-height: 170px; object-fit: contain;">
            <% } else { %>
                <h3 class="fw-bold text-uppercase"><%= lembaga.nama_organisasi %></h3>
                <p class="mb-0 small"><%= lembaga.alamat || 'Alamat Sekretariat Lembaga' %> | Telp: <%= lembaga.nomor_hp || '-' %></p>
            <% } %>
        </div>

        <!-- JUDUL PROPOSAL -->
        <div class="text-center my-4">
            <h4 class="fw-bold text-uppercase">PROPOSAL KEGIATAN</h4>
            <h5 class="fw-bold text-uppercase text-secondary"><%= proker.nama_program %></h5>
            <p class="small text-muted mb-1">Tema: "<%= proposal.tema || '-' %>"</p>
            <p class="fw-bold mt-2 mb-0" style="font-size: 1.2rem; font-family: 'Traditional Arabic', serif;" dir="rtl">اَلسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ</p>
        </div>

        <!-- 1. LATAR BELAKANG -->
        <div class="mb-3">
            <h6 class="fw-bold text-uppercase">I. Latar Belakang</h6>
            <p class="text-justify" style="text-align: justify; white-space: pre-line;"><%= proposal.latar_belakang %></p>
        </div>

        <!-- 2. TUJUAN KEGIATAN -->
        <div class="mb-3">
            <h6 class="fw-bold text-uppercase">II. Tujuan Kegiatan</h6>
            <div style="white-space: pre-line;"><%= proposal.tujuan %></div>
        </div>

        <!-- 3. WAKTU & TEMPAT -->
        <div class="mb-3">
            <h6 class="fw-bold text-uppercase">III. Waktu & Tempat Pelaksanaan</h6>
            <ul>
                <% 
                    const namaBulan = ["", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                    let rawBulan = String(proker.waktu_pelaksanaan || '');
                    let arrBulan = rawBulan.split(',').map(b => parseInt(b.trim())).filter(Boolean);
                    let namaBulanTampil = arrBulan.length > 0 ? namaBulan[arrBulan[0]] : '-'; 
                %>
                <li>Bulan Pelaksanaan: <strong><%= namaBulanTampil %></strong> (Tahun Anggaran <%= proker.tahun %>)</li>
                <li>Tempat: Ruang Lingkup Operasional Lembaga / Sesuai Ketentuan Bidang</li>
            </ul>
        </div>

        <!-- 4. RENCANA ANGGARAN BIAYA (RAB) -->
        <div class="mb-4">
            <h6 class="fw-bold text-uppercase">IV. Rencana Anggaran Biaya (RAB)</h6>
            <table class="table table-bordered table-sm align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 5%;">No</th>
                        <th>Uraian Kebutuhan</th>
                        <th style="width: 20%;">Vol / Satuan</th>
                        <th style="width: 22%;">Harga Satuan</th>
                        <th style="width: 25%;">Jumlah</th>
                    </tr>
                </thead>
                <tbody>
                    <% 
                        let totalGlobalRAB = 0;
                        let rabItems = (typeof rincianRab !== 'undefined' && rincianRab) ? rincianRab : ((proker && proker.RincianBiayas) ? proker.RincianBiayas : []);
                    %>

                    <% if (rabItems.length > 0) { %>
                        <% rabItems.forEach((item, index) => { %>
                            <% 
                                let volume = item.jumlah || item.volume || item.qty || 1;
                                let satuan = item.satuan || '';
                                let hargaSatuan = item.harga_satuan || item.harga || 0;
                                let subTotal = volume * hargaSatuan;
                                totalGlobalRAB += subTotal;
                            %>
                            <tr>
                                <td class="text-center"><%= index + 1 %></td>
                                <td><%= item.uraian || item.nama_item || item.nama_barang || '-' %></td>
                                <td class="text-center"><%= volume %> <%= satuan %></td>
                                <td class="text-end">Rp <%= Number(hargaSatuan).toLocaleString('id-ID') %></td>
                                <td class="text-end fw-bold">Rp <%= Number(subTotal).toLocaleString('id-ID') %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <% totalGlobalRAB = proker.anggaran || 0; %>
                        <tr>
                            <td class="text-center">1</td>
                            <td>Alokasi Anggaran Utama Kegiatan: <%= proker.nama_program %></td>
                            <td class="text-center">1 Paket</td>
                            <td class="text-end">Rp <%= Number(proker.anggaran || 0).toLocaleString('id-ID') %></td>
                            <td class="text-end fw-bold">Rp <%= Number(proker.anggaran || 0).toLocaleString('id-ID') %></td>
                        </tr>
                    <% } %>
                </tbody>
                <tfoot>
                    <tr class="table-light fw-bold">
                        <td colspan="4" class="text-end">TOTAL KEBUTUHAN DANA:</td>
                        <td class="text-end text-danger">Rp <%= Number(totalGlobalRAB).toLocaleString('id-ID') %></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- 5. PENUTUP -->
        <div class="mb-5">
            <h6 class="fw-bold text-uppercase">V. Penutup</h6>
            <p class="text-justify mb-3" style="text-align: justify;">
                Demikian proposal dan Rencana Anggaran Biaya (RAB) ini kami sampaikan. Besar harapan kami atas dukungan, bimbingan, serta pengesahan dari Bapak/Ibu pimpinan dan pembina sekalian demi kelancaran dan kesuksesan program kerja ini. Atas perhatian dan kerjasamanya, kami ucapkan terima kasih.
            </p>
            <div class="mt-3 text-center">
                <p class="fw-bold mb-1" style="font-size: 1.2rem; font-family: 'Traditional Arabic', serif;" dir="rtl">اَلْحَمْدُ للهِ، جَزَاكُمُ اللهُ خَيْرًا</p>
                <p class="fw-bold mb-0" style="font-size: 1.1rem; font-family: 'Traditional Arabic', serif;" dir="rtl">وَالسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهُ</p>
            </div>
        </div>

       <!-- LEMBAR TANDA TANGAN & TANGGAL PENGAJUAN -->
        <% 
            let showStempel        = Boolean(lembaga.print_stempel);
            let showTtdKetuaImg    = Boolean(lembaga.print_ttd_ketua_img);
            let showTtdPengajuImg  = Boolean(lembaga.print_ttd_pengaju_img);
            let showTtdPembinaImg = Boolean(lembaga.print_ttd_pembina_img);
            let showKetua          = Boolean(lembaga.print_ketua);
            let showPengaju        = Boolean(lembaga.print_pengaju);
            let showPembinaLembaga = Boolean(lembaga.print_pembina_lembaga);
            let showPembina        = Boolean(lembaga.print_pembina);

            function toTitleCase(str) {
                if (!str) return '';
                return str.toLowerCase().split(' ').map(word => {
                    return word.charAt(0).toUpperCase() + word.slice(1);
                }).join(' ');
            }
        %>

        <div class="mt-4 pt-2">
            <!-- Baris Tanggal Pengajuan -->
            <div class="row text-center mb-1">
                <div class="col-6"></div>
                <div class="col-6">
                    <% 
                        const bulanIndo = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                        let tglSkrg = new Date();
                        let tanggalCetak = tglSkrg.getDate() + " " + bulanIndo[tglSkrg.getMonth()] + " " + tglSkrg.getFullYear();
                    %>
                    <p class="mb-0">Jombang, <%= tanggalCetak %></p>
                </div>
            </div>

            <div class="row text-center">
                <!-- 1. Kolom Pengaju / Bidang -->
                <% if (showPengaju) { %>
                    <div class="col-6 mb-4">
                        <p class="mb-1">Diajukan Oleh,</p>
                        <p class="fw-bold mb-2">
                            <% if (typeof userSession !== 'undefined' && userSession.jabatan && userSession.jabatan.trim() !== '') { %>
                                <%= userSession.jabatan %>
                            <% } else if (proker && proker.Bidang && proker.Bidang.nama_bidang) { %>
                                <%= proker.Bidang.nama_bidang %>
                            <% } else { %>
                                Pengaju
                            <% } %>
                        </p>
                        
                        <div class="signature-box mb-2" style="min-height: 100px;">
                            <% if (showTtdPengajuImg && proker && proker.Bidang && proker.Bidang.ttd_bidang) { %>
                                <img src="/uploads/logo/<%= proker.Bidang.ttd_bidang %>" alt="TTD Bidang" style="max-height: 130px; width: auto; object-fit: contain;">
                            <% } else if (showTtdPengajuImg && lembaga.ttd_pengaju) { %>
                                <img src="/uploads/logo/<%= lembaga.ttd_pengaju %>" alt="TTD Pengaju" style="max-height: 100px; width: auto; object-fit: contain;">
                            <% } %>
                        </div>

                        <p class="fw-bold mb-0 text-decoration-underline"><%= (typeof userSession !== 'undefined' && userSession.nama_lengkap) ? userSession.nama_lengkap : 'Diyanto, S.Pd' %></p>
                    </div>
                <% } else { %>
                    <div class="col-6 mb-4"></div>
                <% } %>

                <!-- 2. Kolom Ketua Lembaga & Stempel -->
                <% if (showKetua) { %>
                    <div class="col-6 mb-4 position-relative">
                        <p class="mb-1">Mengetahui,</p>
                        <p class="fw-bold mb-2">Ketua <%= toTitleCase(lembaga.nama_organisasi) %></p>
                        
                        <div class="signature-box mb-2" style="min-height: 100px;">
                            <% if (showStempel && lembaga.stempel) { %>
                                <div style="position: absolute; left: 15%; transform: translateX(-50%); top: 15px; opacity: 0.85; pointer-events: none; z-index: 2;">
                                    <img src="/uploads/logo/<%= lembaga.stempel %>" alt="Stempel Lembaga" style="width: 200px; height: 100px; object-fit: contain;">
                                </div>
                            <% } %>

                            <% if (showTtdKetuaImg && lembaga.ttd_ketua) { %>
                                <img src="/uploads/logo/<%= lembaga.ttd_ketua %>" alt="TTD Ketua" style="max-height: 100px; width: auto; object-fit: contain; position: relative; z-index: 1;">
                            <% } %>
                        </div>

                        <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.nama_ketua || 'Agus Efendy' %></p>
                    </div>
                <% } else { %>
                    <div class="col-6 mb-4"></div>
                <% } %>

                <!-- 3. Kolom Pembina Lembaga -->
                <% if (showPembinaLembaga && lembaga.pembina_senkom) { %>
                    <div class="col-12 d-flex justify-content-center mb-4">
                        <div style="width: 50%;">
                            <p class="mb-1">Mengesahkan / Menyetujui,</p>
                            <p class="fw-bold mb-2">Pembina <%= toTitleCase(lembaga.nama_organisasi) %></p>
                            
                            <div class="signature-box mb-2" style="min-height: 90px;">
                                <% if (showTtdPembinaImg && lembaga.ttd_pembina_senkom) { %>
                                    <img src="/uploads/logo/<%= lembaga.ttd_pembina_senkom %>" alt="TTD Pembina Senkom" style="max-height: 90px; object-fit: contain;">
                                <% } %>
                            </div>
                            <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.pembina_senkom %></p>
                        </div>
                    </div>
                <% } %>

                <!-- 4. Slot 6 Pembina Wilayah / Dewan Penasihat -->
                <% if (showPembina) { %>
                    <% 
                        let pembinaList = [
                            { nama: lembaga.pembina_1, wilayah: 'Pembina Jombang Kota' },
                            { nama: lembaga.pembina_2, wilayah: 'Pembina Jombang Barat' },
                            { nama: lembaga.pembina_3, wilayah: 'Pembina Jombang Timur' },
                            { nama: lembaga.pembina_4, wilayah: 'Pembina Jombang Utara' },
                            { nama: lembaga.pembina_5, wilayah: 'Pembina Jombang Selatan' },
                            { nama: lembaga.pembina_6, wilayah: 'Pembina Muhajir Gadingmangu' }
                        ].filter(p => p.nama && p.nama.trim() !== '');
                    %>

                    <% if (pembinaList.length > 0) { %>
                        <div class="col-12 mt-3 mb-2 page-break-safe"><hr><p class="fw-bold big mb-2 text-uppercase text-center">Dewan Pembina</p></div>
                        <% pembinaList.forEach((pembina) => { %>
                            <div class="col-4 mb-4 text-center page-break-safe">
                                <!-- PERBAIKAN PRESISI: Mengunci tinggi area teks wilayah agar sejajar rapi walau 2 baris -->
                                <div style="min-height: 48px; display: flex; align-items: flex-end; justify-content: center;" class="mb-2">
                                    <p class="mb-0 big"><%= pembina.wilayah %></p>
                                </div>
                                
                                <div class="signature-box mb-2" style="min-height: 95px;"></div>
                                <p class="fw-bold big mb-2 text-decoration-underline"><%= pembina.nama %></p>
                            </div>
                        <% }) %>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Script JavaScript untuk Menampilkan Watermark Otomatis Berdasarkan Status -->
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('watermarkContainer');
            if (container) {
                // Ambil status proposal dari server/EJS
                const proposalStatus = "<%= proposal.status %>";
                const isUrlPreview = new URLSearchParams(window.location.search).get('mode') === 'preview';

                // Jika status belum "Disetujui" ATAU URL mengandung mode preview, tampilkan watermark!
                if (proposalStatus !== 'Disetujui' || isUrlPreview) {
                    container.innerHTML = '<div class="watermark-draft">DRAFT PROPOSAL</div>';
                }
            }
        });
    </script>
</body>
</html>
