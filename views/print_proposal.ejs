<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Proposal - <%= proker.nama_program %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #ffffff; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.6; }
        .sheet { width: 210mm; min-height: 297mm; padding: 20mm; margin: 10mm auto; background: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        @media print {
            body { background: none; }
            .sheet { width: 100%; margin: 0; padding: 10mm; box-shadow: none; }
            .no-print { display: none !important; }
        }
        .signature-box { min-height: 75px; display: flex; align-items: center; justify-content: center; }
    </style>
</head>
<body>

    <!-- Tombol Cetak / Kembali (Hilang Saat Diprint) -->
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4 me-2">
            <i class="fas fa-print me-1"></i> Cetak / Simpan PDF
        </button>
        <a href="/lembaga-admin/proker/proposal/<%= proker.id %>" class="btn btn-outline-secondary fw-bold px-4">
            Kembali ke Editor
        </a>
    </div>

    <div class="sheet">
        <!-- KOP SURAT LEMBAGA -->
        <div class="text-center mb-4 border-bottom pb-3">
            <% if (lembaga.kop_surat) { %>
                <img src="/uploads/logo/<%= lembaga.kop_surat %>" alt="Kop Surat" class="img-fluid" style="max-height: 120px; object-fit: contain;">
            <% } else { %>
                <h3 class="fw-bold text-uppercase"><%= lembaga.nama_organisasi %></h3>
                <p class="mb-0 small"><%= lembaga.alamat || 'Alamat Sekretariat Lembaga' %> | Telp: <%= lembaga.nomor_hp || '-' %></p>
            <% } %>
        </div>

        <!-- JUDUL PROPOSAL -->
        <div class="text-center my-4">
            <h4 class="fw-bold text-uppercase">PROPOSAL KEGIATAN</h4>
            <h5 class="fw-bold text-uppercase text-secondary"><%= proker.nama_program %></h5>
            <p class="small text-muted mb-0">Tema: "<%= proposal.tema || '-' %>"</p>
        </div>

        <!-- 1. LATAR BELAKANG -->
        <div class="mb-3">
            <h6 class="fw-bold text-uppercase">I. Latar Belakang</h6>
            <p class="text-justify" style="text-align: justify; white-space: pre-line;"><%= proposal.latar_belakang %></p>
        </div>

        <!-- 2. TUJUAN KEGIATAN -->
        <div class="mb-3">
            <h6 class="fw-bold text-uppercase">II. Tujuan Kegiatan</h6>
            <div style="white-space: pre-line;"><%= proposal.tujuan %></div>
        </div>

        <!-- 3. WAKTU & TEMPAT -->
        <div class="mb-3">
            <h6 class="fw-bold text-uppercase">III. Waktu & Tempat Pelaksanaan</h6>
            <ul>
                <li>Bulan Pelaksanaan: Bulan ke-<%= proker.waktu_pelaksanaan || '-' %> (Tahun Anggaran <%= proker.tahun %>)</li>
                <li>Tempat: Ruang Lingkup Operasional Lembaga / Sesuai Ketentuan Bidang</li>
            </ul>
        </div>

        <!-- 4. RENCANA ANGGARAN (RAB) -->
        <div class="mb-4">
            <h6 class="fw-bold text-uppercase">IV. Rencana Anggaran Biaya (RAB)</h6>
            <table class="table table-bordered table-sm align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th>No</th>
                        <th>Uraian Kebutuhan Program</th>
                        <th>Jumlah / Nominal Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">1</td>
                        <td>Alokasi Anggaran Utama Kegiatan: <%= proker.nama_program %></td>
                        <td class="text-end fw-bold">Rp <%= proker.anggaran ? proker.anggaran.toLocaleString('id-ID') : '0' %></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="table-light fw-bold">
                        <td colspan="2" class="text-end">TOTAL KEBUTUHAN DANA:</td>
                        <td class="text-end text-danger">Rp <%= proker.anggaran ? proker.anggaran.toLocaleString('id-ID') : '0' %></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- 5. PENUTUP -->
        <div class="mb-5">
            <h6 class="fw-bold text-uppercase">V. Penutup</h6>
            <p class="text-justify" style="text-align: justify;">
                Demikian proposal dan Rencana Anggaran Biaya (RAB) ini kami sampaikan. Besar harapan kami atas dukungan, bimbingan, serta pengesahan dari Bapak/Ibu pimpinan dan pembina sekalian demi kelancaran dan kesuksesan program kerja ini. Atas perhatian dan kerjasamanya, kami ucapkan terima kasih.
            </p>
        </div>

        <!-- LEMBAR TANDA TANGAN (8 SLOT TTD & STEMPEL) -->
        <div class="mt-5 pt-3">
            <div class="row text-center">
                <!-- Kolom Pengaju (Wajib) -->
                <div class="col-6 mb-4">
                    <p class="mb-1">Diajukan Oleh,</p>
                    <p class="fw-bold mb-2">Kepala Bidang / Pengaju</p>
                    
                    <div class="signature-box mb-2">
                        <% if (lembaga.ttd_pengaju) { %>
                            <img src="/uploads/logo/<%= lembaga.ttd_pengaju %>" alt="TTD Pengaju" style="max-height: 60px; object-fit: contain;">
                        <% } %>
                    </div>

                    <p class="fw-bold mb-0 text-decoration-underline"><%= userSession.nama_lengkap || 'Pengaju' %></p>
                </div>

                <!-- Kolom Ketua Lembaga (Wajib) -->
                <div class="col-6 mb-4 position-relative">
                    <p class="mb-1">Mengetahui / Mengesahkan,</p>
                    <p class="fw-bold mb-2">Ketua Lembaga</p>
                    
                    <!-- Stempel Lembaga di Samping Tanda Tangan Ketua -->
                    <% if (lembaga.stempel) { %>
                        <div style="position: absolute; left: 38%; transform: translateX(-50%); bottom: 25px; opacity: 0.85; pointer-events: none;">
                            <img src="/uploads/logo/<%= lembaga.stempel %>" alt="Stempel Lembaga" style="width: 80px; height: 80px; object-fit: cover;">
                        </div>
                    <% } %>

                    <div class="signature-box mb-2">
                        <% if (lembaga.ttd_ketua) { %>
                            <img src="/uploads/logo/<%= lembaga.ttd_ketua %>" alt="TTD Ketua" style="max-height: 60px; object-fit: contain;">
                        <% } %>
                    </div>

                    <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.nama_ketua || 'Pimpinan Lembaga' %></p>
                </div>

                <!-- Slot Pembina Opsional (1 s.d. 6) -->
                <% 
                   let pembinaList = [
                       proposal.pembina_1, proposal.pembina_2, proposal.pembina_3,
                       proposal.pembina_4, proposal.pembina_5, proposal.pembina_6
                   ].filter(p => p && p.trim() !== '');
                %>

                <% if (pembinaList.length > 0) { %>
                    <div class="col-12 mt-3 mb-2"><hr><p class="fw-bold small text-uppercase text-muted">Tim Pembina / Penasihat</p></div>
                    <% pembinaList.forEach((pembinaName, idx) => { %>
                        <div class="col-4 mb-4">
                            <p class="mb-1 small">Pembina <%= idx + 1 %></p>
                            <div class="signature-box mb-2" style="min-height: 50px;"></div>
                            <p class="fw-bold small mb-0 text-decoration-underline"><%= pembinaName %></p>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

    </div>

</body>
</html>
