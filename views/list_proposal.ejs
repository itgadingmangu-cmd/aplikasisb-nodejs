<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Proposal & RAB</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <%- include('partials/sidebar') %>
        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Manajemen Proposal & RAB Kegiatan</h2>
                    <p class="text-muted mb-0">Kelola draf proposal, pengajuan, dan cetak dokumen lengkap dengan 8 slot tanda tangan.</p>
                </div>

                <!-- Notifikasi -->
                <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card p-4 bg-white shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>No</th>
                                    <th>Nama Program Kerja</th>
                                    <th>Bidang</th>
                                    <th>Status Proposal</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (prokers && prokers.length > 0) { %>
                                    <% prokers.forEach((p, idx) => { %>
                                        <tr>
                                            <td class="fw-bold text-muted"><%= idx + 1 %></td>
                                            <td>
                                                <span class="fw-bold text-dark"><%= p.nama_program %></span>
                                                <small class="d-block text-muted">Anggaran: Rp <%= p.anggaran ? p.anggaran.toLocaleString('id-ID') : '0' %></small>
                                            </td>
                                            <td><%= p.Bidang ? p.Bidang.nama_bidang : '-' %></td>
                                            <td>
                                                <% if (p.Proposal) { %>
                                                    <span class="badge bg-<%= p.Proposal.status === 'Disetujui' ? 'success' : (p.Proposal.status === 'Diajukan' ? 'warning text-dark' : 'secondary') %>">
                                                        <%= p.Proposal.status %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-muted border">Belum Dibuat</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center">
                                                <a href="/lembaga-admin/proker/proposal/<%= p.id %>" class="btn btn-sm btn-outline-primary fw-bold">
                                                    <i class="fas fa-edit me-1"></i> Kelola Draf & TTD
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">Belum ada Program Kerja pada tahun aktif.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
