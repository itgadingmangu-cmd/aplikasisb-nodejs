<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Pengajuan</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <%- include('partials/sidebar') %>
        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                <% const thresholdBatas = (typeof batasAnggaranProposal !== 'undefined' && batasAnggaranProposal) ? Number(batasAnggaranProposal) : 2000000; %>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Manajemen Pengajuan Kegiatan</h2>
                        <p class="text-muted mb-0">Kelola pengajuan kegiatan (dengan proposal atau tanpa proposal), draf, dan cetak dokumen lengkap dengan 8 slot tanda tangan.</p>
                    </div>
                    <span class="badge bg-info bg-opacity-10 text-primary border border-info px-3 py-2">
                        <i class="fas fa-sliders-h me-1"></i> Batas Rekomendasi Proposal: <strong>Rp <%= thresholdBatas.toLocaleString('id-ID') %></strong>
                    </span>
                </div>

                <!-- NOTIFIKASI KOREKSI / REVISI UNTUK PENGAJU -->
                <% if (typeof prokers !== 'undefined' && prokers.length > 0) { %>
                    <% prokers.forEach(p => { %>
                        <% if (p.Proposal && (p.Proposal.status === 'Direvisi' || p.Proposal.status === 'Perlu Revisi')) { %>
                            <div class="alert alert-danger border-start border-4 border-danger shadow-sm mb-4" role="alert">
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                    <div>
                                        <h5 class="fw-bold text-danger mb-1">
                                            <i class="fas fa-exclamation-triangle me-2"></i> Pengajuan Perlu Revisi: <%= p.nama_program || p.nama_proker %>
                                        </h5>
                                        <p class="mb-0 text-dark"><strong>Catatan Koreksi Pimpinan:</strong> <%= p.Proposal.catatan_revisi || 'Belum ada catatan detail, silakan periksa kembali pengajuan Anda.' %></p>
                                    </div>
                                    <div>
                                        <a href="/lembaga-admin/proker/proposal/<%= p.id %>" class="btn btn-danger fw-bold px-3 py-2 shadow-sm text-nowrap">
                                            <i class="fas fa-arrow-right me-1"></i> Menuju Pengajuan
                                        </a>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } %>

                <!-- Notifikasi -->
                <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card p-4 bg-white shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>No</th>
                                    <th>Nama Program Kerja</th>
                                    <th>Bidang</th>
                                    <th>Jenis Pengajuan</th>
                                    <th>Status Proposal</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (prokers && prokers.length > 0) { %>
                                    <% prokers.forEach((p, idx) => { %>
                                        <%
                                            const nominalAnggaran = Number(p.anggaran || 0);
                                            const jenisAktif = (p.Proposal && p.Proposal.jenis_pengajuan)
                                                ? p.Proposal.jenis_pengajuan
                                                : (nominalAnggaran > thresholdBatas ? 'dengan_proposal' : 'tanpa_proposal');
                                            const melebihiBatasTanpaProposal = (jenisAktif === 'tanpa_proposal' && nominalAnggaran > thresholdBatas);
                                        %>
                                        <tr>
                                            <td class="fw-bold text-muted"><%= idx + 1 %></td>
                                            <td>
                                                <span class="fw-bold text-dark"><%= p.nama_program %></span>
                                                <small class="d-block text-muted">Anggaran: Rp <%= nominalAnggaran ? nominalAnggaran.toLocaleString('id-ID') : '0' %></small>
                                                <% if (melebihiBatasTanpaProposal) { %>
                                                    <small class="d-block text-warning fw-semibold mt-1">
                                                        <i class="fas fa-info-circle me-1"></i> Anggaran di atas Rp <%= thresholdBatas.toLocaleString('id-ID') %> (disarankan dengan proposal)
                                                    </small>
                                                <% } %>
                                            </td>
                                            <td><%= p.Bidang ? p.Bidang.nama_bidang : '-' %></td>
                                            <td>
                                                <% if (jenisAktif === 'tanpa_proposal') { %>
                                                    <span class="badge bg-info text-dark px-2 py-1">
                                                        <i class="fas fa-file-alt me-1"></i> Tanpa Proposal
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-primary text-white px-2 py-1">
                                                        <i class="fas fa-file-contract me-1"></i> Dengan Proposal
                                                    </span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (p.Proposal) { %>
                                                    <span class="badge bg-<%= p.Proposal.status === 'Disetujui' ? 'success' : (p.Proposal.status === 'Diajukan' ? 'warning text-dark' : (p.Proposal.status === 'Direvisi' || p.Proposal.status === 'Perlu Revisi' ? 'danger' : 'secondary')) %>">
                                                        <%= p.Proposal.status === 'Direvisi' ? 'Perlu Revisi' : p.Proposal.status %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-muted border">Belum Dibuat</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center">
                                                <div class="d-inline-flex gap-1">
                                                    <a href="/lembaga-admin/proker/proposal/<%= p.id %>" class="btn btn-sm btn-outline-primary fw-bold">
                                                        <i class="fas fa-edit me-1"></i> Kelola Pengajuan
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Belum ada Program Kerja pada tahun aktif.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
