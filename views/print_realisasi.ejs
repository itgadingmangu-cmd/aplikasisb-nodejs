<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Laporan Realisasi Anggaran - <%= lembaga.nama_organisasi %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #ffffff; font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.5; }
        .sheet { width: 210mm; min-height: 297mm; padding: 15mm 20mm; margin: 10mm auto; background: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); position: relative; box-sizing: border-box; }
        
        /* Styling Profesional untuk Tabel Keuangan */
        .table-financial { font-size: 11pt; border-collapse: collapse; width: 100%; }
        .table-financial th { background-color: #f8f9fa !important; color: #000; font-weight: bold; text-align: center; vertical-align: middle; border: 1px solid #000 !important; padding: 10px 8px; }
        .table-financial td { vertical-align: middle; border: 1px solid #000 !important; padding: 8px 10px; }
        
        .signature-box { min-height: 95px; position: relative; display: flex; align-items: center; justify-content: center; }
        
        @media print {
            @page {
                size: A4;
                margin: 10mm;
            }
            body { background: none; margin: 0; }
            .sheet { width: 100%; margin: 0; padding: 5mm; box-shadow: none; }
            .no-print { display: none !important; }
            .page-break-safe { page-break-inside: avoid; }
        }
    </style>
</head>
<body onload="window.print()">

    <!-- Tombol Cetak / Kembali (Hilang Saat Diprint) -->
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4 me-2">
            <i class="fas fa-print me-1"></i> Cetak / Simpan PDF
        </button>
        <a href="/lembaga-admin/realisasi" class="btn btn-outline-secondary fw-bold px-4">
            Kembali ke Laporan
        </a>
    </div>

    <div class="sheet">
        <!-- Kop Surat Lembaga -->
        <div class="text-center mb-3 border-bottom pb-3">
            <% if (lembaga.kop_surat) { %>
                <img src="/uploads/logo/<%= lembaga.kop_surat %>" alt="Kop Surat" class="img-fluid" style="max-height: 150px; object-fit: contain;">
            <% } else { %>
                <h3 class="fw-bold text-uppercase"><%= lembaga.nama_organisasi %></h3>
                <p class="mb-0 small"><%= lembaga.alamat || 'Alamat Sekretariat Lembaga' %> | Telp: <%= lembaga.nomor_hp || '-' %></p>
            <% } %>
        </div>

        <!-- Header Judul & Periode di Atas -->
        <div class="text-center my-3">
            <h4 class="fw-bold text-uppercase mb-1" style="letter-spacing: 0.5px;">Laporan Realisasi Anggaran</h4>
            <p class="text-dark small mb-0 fw-semibold">Tahun Anggaran: <%= tahunAktif %></p>
            <% if (typeof query !== 'undefined' && query.start_date && query.end_date) { %>
                <% 
                    // Fungsi helper untuk format tanggal Indonesia
                    function formatTglIndo(dateStr) {
                        if (!dateStr) return '';
                        const d = new Date(dateStr);
                        if (isNaN(d)) return dateStr;
                        const bulanArr = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                        return d.getDate() + " " + bulanArr[d.getMonth()] + " " + d.getFullYear();
                    }

                    // Hitung estimasi durasi bulan secara otomatis
                    let dStart = new Date(query.start_date);
                    let dEnd = new Date(query.end_date);
                    let diffTime = Math.abs(dEnd - dStart);
                    let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                    let labelDurasi = '';
                    
                    if (diffDays >= 340 && diffDays <= 380) {
                        labelDurasi = ' (Laporan Tahunan)';
                    } else if (diffDays >= 80 && diffDays <= 100) {
                        labelDurasi = ' (Laporan Triwulanan / 3 Bulan)';
                    } else if (diffDays >= 170 && diffDays <= 190) {
                        labelDurasi = ' (Laporan Semesteran / 6 Bulan)';
                    } else if (diffDays >= 25 && diffDays <= 32) {
                        labelDurasi = ' (Laporan Bulanan)';
                    } else {
                        let estimasiBulan = Math.round(diffDays / 30);
                        if (estimasiBulan > 1) {
                            labelDurasi = ' (Periode ' + estimasiBulan + ' Bulan)';
                        }
                    }
                %>
                <p class="text-dark small mb-0 mt-1 fw-semibold">
                    Periode: <%= formatTglIndo(query.start_date) %> s.d. <%= formatTglIndo(query.end_date) %> <%= labelDurasi %>
                </p>
            <% } %>
        </div>

        <!-- Tabel Rekapitulasi Keuangan -->
        <div class="table-responsive mb-4">
            <table class="table table-financial align-middle">
                <thead>
                    <tr>
                        <th style="width: 5%;">No</th>
                        <th style="width: 29%;">Program Kerja & Bidang</th>
                        <th style="width: 14%;">Tgl Realisasi</th>
                        <th style="width: 17%;">Total RAB (Rencana)</th>
                        <th style="width: 17%;">Total Realisasi (Riil)</th>
                        <th style="width: 18%;">Sisa / Selisih</th>
                    </tr>
                </thead>
                <tbody>
                    <% 
                        let grandTotalRAB = 0;
                        let grandTotalRealisasi = 0;
                    %>
                    <% if (listProker && listProker.length > 0) { %>
                        <% listProker.forEach((p, index) => { %>
                            <% 
                                let totalRAB = p.RincianBiayas ? p.RincianBiayas.reduce((s, i) => s + (parseFloat(i.total) || 0), 0) : 0;
                                let totalRealisasi = p.Realisasis ? p.Realisasis.reduce((s, r) => s + (parseFloat(r.nominal_realisasi) || 0), 0) : 0;
                                let selisih = totalRAB - totalRealisasi;

                                // Mengambil Tanggal Realisasi secara aman
                                let tanggalRealisasiStr = '-';
                                if (p.Realisasis && p.Realisasis.length > 0) {
                                    let tgls = p.Realisasis.map(r => {
                                        let rawTgl = r.tanggal || r.tanggal_realisasi || r.createdAt;
                                        if (rawTgl) {
                                            let d = new Date(rawTgl);
                                            return d.toLocaleDateString('id-ID', {day: '2-digit', month: '2-digit', year: 'numeric'});
                                        }
                                        return null;
                                    }).filter(Boolean);
                                    if (tgls.length > 0) {
                                        tanggalRealisasiStr = [...new Set(tgls)].join(', ');
                                    }
                                }

                                grandTotalRAB += totalRAB;
                                grandTotalRealisasi += totalRealisasi;
                            %>
                            <tr>
                                <td class="text-center fw-bold"><%= index + 1 %></td>
                                <td>
                                    <span class="fw-bold text-dark"><%= p.nama_program || p.nama_proker %></span><br>
                                    <small class="text-secondary fst-italic"><%= p.Bidang ? p.Bidang.nama_bidang : 'Umum' %></small>
                                </td>
                                <td class="text-center small"><%= tanggalRealisasiStr %></td>
                                <td class="text-end" style="white-space: nowrap;">Rp <%= totalRAB.toLocaleString('id-ID') %></td>
                                <td class="text-end" style="white-space: nowrap;">Rp <%= totalRealisasi.toLocaleString('id-ID') %></td>
                                <td class="text-end fw-semibold <%= selisih < 0 ? 'text-danger' : 'text-dark' %>" style="white-space: nowrap;">
                                    Rp <%= selisih.toLocaleString('id-ID') %>
                                </td>
                            </tr>
                        <% }) %>
                        <tr class="table-light fw-bold" style="background-color: #f1f3f5 !important;">
                            <td colspan="3" class="text-end py-2">TOTAL KESELURUHAN:</td>
                            <td class="text-end py-2" style="white-space: nowrap;">Rp <%= grandTotalRAB.toLocaleString('id-ID') %></td>
                            <td class="text-end py-2" style="white-space: nowrap;">Rp <%= grandTotalRealisasi.toLocaleString('id-ID') %></td>
                            <td class="text-end py-2" style="white-space: nowrap;">Rp <%= (grandTotalRAB - grandTotalRealisasi).toLocaleString('id-ID') %></td>
                        </tr>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted fst-italic">
                                Belum ada data program kerja atau realisasi 
                                <% if (typeof query !== 'undefined' && query.start_date && query.end_date) { %>
                                    pada rentang tanggal <%= query.start_date %> s.d. <%= query.end_date %>
                                <% } else { %>
                                    pada Tahun Anggaran <%= tahunAktif %>
                                <% } %>.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- LEMBAR TANDA TANGAN & TANGGAL PENGAJUAN -->
        <% 
            let showStempel       = (query.show_stempel === 'true');
            let showTtdKetuaImg   = (query.show_ttd_ketua_img === 'true');
            let showTtdPengajuImg = (query.show_ttd_pengaju_img === 'true');
            let showKolomKetua    = (query.show_ketua === 'true');
            let showKolomPengaju  = (query.show_pengaju === 'true');
            let showPembina       = (query.show_pembina === 'true');

            let rLogin = (userSession.role || '').toLowerCase();
            let jLogin = (userSession.jabatan || '').toLowerCase();
            let isPusat = (
                rLogin === 'admin_lembaga' || 
                rLogin === 'superadmin' || 
                rLogin === 'bendahara_utama' || 
                jLogin === 'bendahara' || 
                jLogin === 'ketua' || 
                jLogin === 'sekretaris' ||
                rLogin === 'admin'
            );

            function toTitleCase(str) {
                if (!str) return '';
                return str.toLowerCase().split(' ').map(word => {
                    return word.charAt(0).toUpperCase() + word.slice(1);
                }).join(' ');
            }
        %>

        <div class="mt-4 pt-2 page-break-safe">
            <!-- Baris Tanggal Tanda Tangan di Bawah -->
            <div class="row text-center mb-1">
                <div class="col-6"></div>
                <div class="col-6">
                    <% 
                        const bulanIndo = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
                        let tglSkrg = new Date();
                        let tanggalCetak = tglSkrg.getDate() + " " + bulanIndo[tglSkrg.getMonth()] + " " + tglSkrg.getFullYear();
                    %>
                    <p class="mb-0">Jombang, <%= tanggalCetak %></p>
                </div>
            </div>

            <!-- Baris Tanda Tangan Utama -->
            <div class="row text-center">
                <% if (isPusat) { %>
                    <!-- JIKA LOGIN PIMPINAN / KETUA / ADMIN -->
                    <% if (showKolomPengaju) { %>
                        <div class="col-6 mb-4 position-relative">
                            <p class="mb-1">Dibuat Oleh,</p>
                            <p class="fw-bold mb-2">Ketua <%= toTitleCase(lembaga.nama_organisasi) %></p>
                            
                            <div class="signature-box mb-2">
                                <% if (showStempel && lembaga.stempel) { %>
                                    <div style="position: absolute; left: 20%; transform: translateX(-50%); top: -15px; opacity: 0.85; pointer-events: none; z-index: 2;">
                                        <img src="/uploads/logo/<%= lembaga.stempel %>" alt="Stempel Lembaga" style="width: 180px; height: 150px; object-fit: contain;">
                                    </div>
                                <% } %>

                                <% if (showTtdKetuaImg && lembaga.ttd_ketua) { %>
                                    <img src="/uploads/logo/<%= lembaga.ttd_ketua %>" alt="TTD Ketua" style="max-height: 85px; width: auto; object-fit: contain; position: relative; z-index: 1;">
                                <% } %>
                            </div>

                            <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.nama_ketua || '-' %></p>
                        </div>
                    <% } else { %>
                        <div class="col-6 mb-4"></div>
                    <% } %>

                    <% if (showKolomKetua) { %>
                        <div class="col-6 mb-4">
                            <p class="mb-1">Mengetahui / Menyetujui,</p>
                            <p class="fw-bold mb-2">Pembina <%= toTitleCase(lembaga.nama_organisasi) %></p>
                            
                            <div class="signature-box mb-2">
                                <% if (showTtdPengajuImg && lembaga.ttd_pembina_senkom) { %>
                                    <img src="/uploads/logo/<%= lembaga.ttd_pembina_senkom %>" alt="TTD Pembina" style="max-height: 85px; width: auto; object-fit: contain;">
                                <% } %>
                            </div>

                            <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.pembina_senkom || '-' %></p>
                        </div>
                    <% } else { %>
                        <div class="col-6 mb-4"></div>
                    <% } %>

                <% } else { %>
                    <!-- JIKA LOGIN BIDANG / PENGAJU -->
                    <% if (showKolomPengaju) { %>
                        <div class="col-6 mb-4">
                            <p class="mb-1">Dibuat Oleh,</p>
                            <p class="fw-bold mb-2">Pengaju / Bidang</p>
                            
                            <div class="signature-box mb-2">
                                <% 
                                    // Mengambil file TTD khusus milik user/pengaju yang sedang login dari kolom 'ttd' tabel Users
                                    let ttdPengajuFile = (typeof userSession !== 'undefined' && userSession.ttd) ? userSession.ttd : lembaga.ttd_pengaju; 
                                %>
                                <% if (showTtdPengajuImg && ttdPengajuFile) { %>
                                    <img src="/uploads/logo/<%= ttdPengajuFile %>" alt="TTD Pengaju" style="max-height: 85px; width: auto; object-fit: contain;">
                                <% } %>
                            </div>

                            <p class="fw-bold mb-0 text-decoration-underline"><%= userSession.nama_lengkap || '-' %></p>
                        </div>
                    <% } else { %>
                        <div class="col-6 mb-4"></div>
                    <% } %>

                    <% if (showKolomKetua) { %>
                        <div class="col-6 mb-4 position-relative">
                            <p class="mb-1">Mengetahui,</p>
                            <p class="fw-bold mb-2">Ketua <%= toTitleCase(lembaga.nama_organisasi) %></p>
                            
                            <div class="signature-box mb-2">
                                <% if (showStempel && lembaga.stempel) { %>
                                    <div style="position: absolute; left: 20%; transform: translateX(-50%); top: -15px; opacity: 0.85; pointer-events: none; z-index: 2;">
                                        <img src="/uploads/logo/<%= lembaga.stempel %>" alt="Stempel Lembaga" style="width: 180px; height: 150px; object-fit: contain;">
                                    </div>
                                <% } %>

                                <% if (showTtdKetuaImg && lembaga.ttd_ketua) { %>
                                    <img src="/uploads/logo/<%= lembaga.ttd_ketua %>" alt="TTD Ketua" style="max-height: 85px; width: auto; object-fit: contain; position: relative; z-index: 1;">
                                <% } %>
                            </div>

                            <p class="fw-bold mb-0 text-decoration-underline"><%= lembaga.nama_ketua || '-' %></p>
                        </div>
                    <% } else { %>
                        <div class="col-6 mb-4"></div>
                    <% } %>
                <% } %>
            </div>

            <!-- Slot 6 Pembina Wilayah / Dewan Penasihat -->
            <% if (showPembina) { %>
                <% 
                    let pembinaList = [
                        { nama: lembaga.pembina_1, wilayah: 'Pembina Jombang Kota' },
                        { nama: lembaga.pembina_2, wilayah: 'Pembina Jombang Barat' },
                        { nama: lembaga.pembina_3, wilayah: 'Pembina Jombang Timur' },
                        { nama: lembaga.pembina_4, wilayah: 'Pembina Jombang Utara' },
                        { nama: lembaga.pembina_5, wilayah: 'Pembina Jombang Selatan' },
                        { nama: lembaga.pembina_6, wilayah: 'Pembina Muhajir Gadingmangu' }
                    ].filter(p => p.nama && p.nama.trim() !== '');
                %>

                <% if (pembinaList.length > 0) { %>
                    <div class="row text-center mt-3">
                        <div class="col-12 mb-2"><hr><p class="fw-bold mb-2 text-uppercase">Dewan Pembina</p></div>
                        <% pembinaList.forEach((pembina) => { %>
                            <div class="col-4 mb-4 text-center">
                                <div style="min-height: 40px; display: flex; align-items: flex-end; justify-content: center;" class="mb-2">
                                    <p class="mb-0 small"><%= pembina.wilayah %></p>
                                </div>
                                <div class="signature-box mb-2" style="min-height: 75px;"></div>
                                <p class="fw-bold small mb-0 text-decoration-underline"><%= pembina.nama %></p>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            <% } %>
        </div>
    </div>

</body>
</html>
