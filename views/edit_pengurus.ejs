<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Data Pengurus & Role</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Edit Pengurus & Role Akses</h2>
                    <p class="text-muted mb-0">Perbarui informasi akun, jabatan, dan hak akses sistem pengurus.</p>
                </div>

                <div class="row justify-content-center">
                    <div class="col-lg-6">
                        <div class="card p-4 bg-white">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="fas fa-user-edit text-primary me-2"></i> Form Edit: <%= targetUser.nama_lengkap %>
                            </h5>
                            <form action="/lembaga-admin/pengurus/edit/<%= targetUser.id %>" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Nama Lengkap & Gelar</label>
                                    <input type="text" class="form-control" name="nama_lengkap" value="<%= targetUser.nama_lengkap %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Username Login</label>
                                    <input type="text" class="form-control" name="username" value="<%= targetUser.username %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Password Baru <span class="text-muted fw-normal">(Kosongkan jika tidak diubah)</span></label>
                                    <input type="password" class="form-control" name="password" placeholder="******">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Hierarki Jabatan</label>
                                    <select class="form-select" name="jabatan" required>
                                        <option value="">-- Pilih Jabatan --</option>
                                        <optgroup label="Pimpinan Tertinggi">
                                            <option value="Ketua" <%= targetUser.jabatan === 'Ketua' ? 'selected' : '' %>>Ketua</option>
                                            <option value="Wakil Ketua" <%= targetUser.jabatan === 'Wakil Ketua' ? 'selected' : '' %>>Wakil Ketua</option>
                                            <option value="Sekretaris" <%= targetUser.jabatan === 'Sekretaris' ? 'selected' : '' %>>Sekretaris</option>
                                            <option value="Bendahara" <%= targetUser.jabatan === 'Bendahara' ? 'selected' : '' %>>Bendahara</option>
                                        </optgroup>
                                        <optgroup label="Bidang Teknis / Anggota">
                                            <option value="Ketua Bidang" <%= targetUser.jabatan === 'Ketua Bidang' ? 'selected' : '' %>>Ketua Bidang</option>
                                            <option value="Anggota Bidang" <%= targetUser.jabatan === 'Anggota Bidang' ? 'selected' : '' %>>Anggota Bidang</option>
                                        </optgroup>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Role Sistem</label>
                                    <select class="form-select" name="role" required>
                                        <option value="admin_lembaga" <%= targetUser.role === 'admin_lembaga' ? 'selected' : '' %>>Admin Lembaga (Akses Penuh / Bendahara Utama)</option>
                                        <option value="pengurus_bidang" <%= targetUser.role === 'pengurus_bidang' ? 'selected' : '' %>>Pengurus Bidang (Akses Pengaju / Wakil Bendahara)</option>
                                    </select>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-bold small">Penugasan Bidang</label>
                                    <select class="form-select" name="id_bidang">
                                        <option value="">-- Pilih Bidang (Opsional / Pimpinan) --</option>
                                        <% if (lembagaData && lembagaData.Bidangs) { %>
                                            <% lembagaData.Bidangs.forEach(b => { %>
                                                <option value="<%= b.id %>" <%= targetUser.id_bidang == b.id ? 'selected' : '' %>><%= b.nama_bidang %></option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                        <i class="fas fa-save me-1"></i> Simpan Perubahan
                                    </button>
                                    <a href="/lembaga-admin/pengurus" class="btn btn-secondary w-100 fw-bold py-2">
                                        Kembali
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
