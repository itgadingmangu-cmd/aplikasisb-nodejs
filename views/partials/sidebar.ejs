<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-primary" style="width: 280px; min-height: 100vh;">
    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
        <span class="fs-5 fw-bold"><i class="fas fa-shield-alt me-2"></i> Ruang Kerja</span>
    </a>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto">
        <% if (typeof userSession !== 'undefined' && userSession.role === 'admin_lembaga') { %>
            <li class="nav-item mb-1">
                <a href="/lembaga-admin" class="nav-link text-white active bg-white text-primary fw-bold">
                    <i class="fas fa-home me-2"></i> Dashboard Lembaga
                </a>
            </li>
        <% } else { %>
            <li class="nav-item mb-1">
                <a href="/" class="nav-link text-white">
                    <i class="fas fa-home me-2"></i> Dashboard Pusat
                </a>
            </li>
        <% } %>
    </ul>
    <hr>
    <div class="dropdown">
        <div class="d-flex align-items-center text-white text-decoration-none">
            <i class="fas fa-user-circle fs-3 me-2"></i>
            <div>
                <strong class="d-block small"><%= typeof userSession !== 'undefined' ? userSession.nama_lengkap : 'User' %></strong>
                <span class="text-white-50" style="font-size: 0.75rem;"><%= typeof userSession !== 'undefined' ? (userSession.role === 'superadmin' ? 'Superadmin' : 'Admin Lembaga') : '' %></span>
            </div>
        </div>
        <div class="mt-3">
            <a href="/logout" class="btn btn-light btn-sm w-100 text-danger fw-bold">
                <i class="fas fa-sign-out-alt me-1"></i> Keluar
            </a>
        </div>
    </div>
</div>
