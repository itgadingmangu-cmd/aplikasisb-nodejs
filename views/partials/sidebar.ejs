<!-- Sidebar Responsif Global (Otomatis menyesuaikan laptop dan HP tanpa merusak fungsi) -->
<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-primary sidebar-responsive" style="width: 280px; min-height: 100vh;">
    
    <!-- 1. NAMA & LOGO APLIKASI INDUK (GLOBAL) -->
    <a href="/" class="d-flex align-items-center mb-3 text-white text-decoration-none">
        <% if (typeof globalSetting !== 'undefined' && globalSetting && globalSetting.logo_aplikasi) { %>
            <img src="/uploads/logo/<%= globalSetting.logo_aplikasi %>" alt="Logo" class="rounded-circle me-2 border bg-white" style="width: 32px; height: 32px; object-fit: cover;">
        <% } else if (typeof pengaturan !== 'undefined' && pengaturan && pengaturan.logo_aplikasi) { %>
            <img src="/uploads/logo/<%= pengaturan.logo_aplikasi %>" alt="Logo" class="rounded-circle me-2 border bg-white" style="width: 32px; height: 32px; object-fit: cover;">
        <% } else { %>
            <i class="fas fa-layer-group fs-4 me-2"></i>
        <% } %>
        <span class="fs-6 fw-bold text-truncate">
            <%= (typeof globalSetting !== 'undefined' && globalSetting && globalSetting.nama_aplikasi) ? globalSetting.nama_aplikasi : ((typeof pengaturan !== 'undefined' && pengaturan && pengaturan.nama_aplikasi) ? pengaturan.nama_aplikasi : 'Aplikasi Program Kerja') %>
        </span>
    </a>

    <!-- 2. KOTAK LEMBAGA AKTIF -->
    <div class="bg-white text-dark p-2 rounded-3 mb-3 shadow-sm d-flex align-items-center">
        <% 
            let activeLembaga = (typeof lembagaData !== 'undefined' && lembagaData) ? lembagaData : ((typeof lembaga !== 'undefined' && lembaga) ? lembaga : null);
            let lembagaLogo = null;
            if (activeLembaga) {
                lembagaLogo = activeLembaga.logo || activeLembaga.logo_icon || activeLembaga.foto;
            }
        %>
        <% if (lembagaLogo) { %>
            <img src="/uploads/logo/<%= lembagaLogo %>" alt="Logo" class="rounded-circle me-2 border" style="width: 38px; height: 38px; object-fit: cover;" onerror="this.style.display='none'">
        <% } else { %>
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 38px; height: 38px; font-size: 0.9rem; min-width: 38px;">
                <%= activeLembaga && activeLembaga.nama_organisasi ? activeLembaga.nama_organisasi.charAt(0).toUpperCase() : 'L' %>
            </div>
        <% } %>
        <div class="overflow-hidden">
            <span class="d-block text-muted" style="font-size: 0.65rem; line-height: 1;">Lembaga Aktif:</span>
            <strong class="text-truncate d-block text-dark fw-bold" style="font-size: 0.85rem;" title="<%= activeLembaga ? activeLembaga.nama_organisasi : 'Nama Lembaga' %>">
                <%= activeLembaga ? activeLembaga.nama_organisasi : 'Nama Lembaga' %>
            </strong>
        </div>
    </div>

    <!-- 3. TOMBOL HOME / DASHBOARD -->
    <a href="/lembaga-admin" class="btn btn-light w-100 text-primary fw-bold mb-3 shadow-sm d-flex align-items-center justify-content-center gap-2 py-2">
        <i class="fas fa-home"></i> Home / Dashboard
    </a>

    <!-- 4. NAVIGASI MENU UTAMA -->
    <ul class="nav nav-pills flex-column mb-auto" id="sidebarNav">
        <% if (typeof userSession !== 'undefined') { %>

            <% if (userSession.role === 'admin_lembaga' || userSession.role === 'superadmin') { %>
                <!-- MENU ORGANISASI (Khusus Admin Lembaga & Superadmin) -->
                <li class="nav-item mb-1">
                    <a href="#orgSubmenu" data-bs-toggle="collapse" class="nav-link text-white d-flex justify-content-between align-items-center text-decoration-none">
                        <span><i class="fas fa-sitemap me-2"></i> Organisasi</span>
                        <i class="fas fa-chevron-down small"></i>
                    </a>
                    <div class="collapse ms-3 mt-1" id="orgSubmenu">
                        <ul class="nav flex-column">
                            <li class="nav-item mb-1">
                                <a href="/lembaga-admin/bidang" class="nav-link text-white small py-1 sub-menu-link">
                                    <i class="fas fa-angle-right me-1"></i> Manajemen Bidang
                                </a>
                            </li>
                            <li class="nav-item mb-1">
                                <a href="/lembaga-admin/pengurus" class="nav-link text-white small py-1 sub-menu-link">
                                    <i class="fas fa-angle-right me-1"></i> Pengurus Bidang
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
            <% } %>

            <!-- MENU PERENCANAAN (Dapat diakses Admin Lembaga & Pengurus Bidang) -->
            <li class="nav-item mb-1">
                <a href="#prokerSubmenu" data-bs-toggle="collapse" class="nav-link text-white d-flex justify-content-between align-items-center text-decoration-none">
                    <span><i class="fas fa-tasks me-2"></i> Perencanaan</span>
                    <i class="fas fa-chevron-down small"></i>
                </a>
                <div class="collapse ms-3 mt-1" id="prokerSubmenu">
                    <ul class="nav flex-column">
                        <li class="nav-item mb-1">
                            <a href="/lembaga-admin/proker" class="nav-link text-white small py-1 sub-menu-link">
                                <i class="fas fa-angle-right me-1"></i> Program Kerja
                            </a>
                        </li>
                        <li class="nav-item mb-1">
                            <a href="/lembaga-admin/proposal" class="nav-link text-white small py-1 sub-menu-link">
                                <i class="fas fa-file-contract me-1"></i> Proposal & RAB
                            </a>
                        </li>
                        <!-- Menu Rekapitulasi Global Tahunan (Khusus Admin Lembaga / Superadmin) -->
                        <% if (userSession.role === 'admin_lembaga' || userSession.role === 'superadmin') { %>
                            <li class="nav-item mb-1">
                                <a href="/lembaga-admin/rekap-global/print" target="_blank" class="nav-link text-white small py-1 sub-menu-link">
                                    <i class="fas fa-file-invoice-dollar me-1"></i> Cetak Rekap Global & RAB
                                </a>
                            </li>
                        <% } %>
                    </ul>
                </div>
            </li>

            <!-- MENU KEUANGAN & LAPORAN -->
            <li class="nav-item mb-1">
                <a href="#keuanganSubmenu" data-bs-toggle="collapse" class="nav-link text-white d-flex justify-content-between align-items-center text-decoration-none">
                    <span><i class="fas fa-wallet me-2"></i> Keuangan & Laporan</span>
                    <i class="fas fa-chevron-down small"></i>
                </a>
                <div class="collapse ms-3 mt-1" id="keuanganSubmenu">
                    <ul class="nav flex-column">
                        <li class="nav-item mb-1">
                            <a href="/lembaga-admin/anggaran" class="nav-link text-white small py-1 sub-menu-link"><i class="fas fa-angle-right me-1"></i> Rincian Anggaran</a>
                        </li>
                        <li class="nav-item mb-1">
                            <a href="/lembaga-admin/realisasi" class="nav-link text-white small py-1 sub-menu-link"><i class="fas fa-angle-right me-1"></i> Laporan Realisasi</a>
                        </li>
                    </ul>
                </div>
            </li>

            <% if (userSession.role === 'admin_lembaga' || userSession.role === 'superadmin') { %>
                <!-- MENU UTILITAS (Khusus Admin Lembaga) -->
                <li class="nav-item mb-1">
                    <a href="#utilitasSubmenu" data-bs-toggle="collapse" class="nav-link text-white d-flex justify-content-between align-items-center text-decoration-none">
                        <span><i class="fas fa-tools me-2"></i> Utilitas</span>
                        <i class="fas fa-chevron-down small"></i>
                    </a>
                    <div class="collapse ms-3 mt-1" id="utilitasSubmenu">
                        <ul class="nav flex-column">
                            <li class="nav-item mb-1">
                                <a href="/lembaga-admin/utilitas/users" class="nav-link text-white small py-1 sub-menu-link"><i class="fas fa-angle-right me-1"></i> Manajemen Akun</a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- MENU SETTING (Khusus Admin Lembaga) -->
                <li class="nav-item mb-1">
                    <a href="/lembaga-admin/setting" class="nav-link text-white">
                        <i class="fas fa-cog me-2"></i> Setting Lembaga
                    </a>
                </li>
            <% } %>

        <% } else { %>
            <li class="nav-item mb-1">
                <a href="/" class="nav-link text-white active bg-white text-primary fw-bold">
                    <i class="fas fa-home me-2"></i> Dashboard Pusat
                </a>
            </li>
        <% } %>
    </ul>

    <!-- 5. INFORMASI USER & TOMBOL KELUAR -->
    <div class="dropdown mt-3 border-top pt-3">
        <div class="d-flex align-items-center text-white text-decoration-none mb-2">
            <i class="fas fa-user-circle fs-3 me-2"></i>
            <div>
                <strong class="d-block small"><%= typeof userSession !== 'undefined' ? userSession.nama_lengkap : 'User' %></strong>
                <span class="text-white-50" style="font-size: 0.75rem;"><%= typeof userSession !== 'undefined' ? (userSession.role === 'superadmin' ? 'Superadmin' : (userSession.nama_bidang ? userSession.nama_bidang : 'Admin Lembaga')) : '' %></span>
            </div>
        </div>
        <a href="/logout" class="btn btn-light btn-sm w-100 text-danger fw-bold rounded-3">
            <i class="fas fa-sign-out-alt me-1"></i> Keluar
        </a>
    </div>
</div>

<!-- Styling Tambahan Khusus CSS Sidebar agar Responsif Otomatis -->
<style>
    @media (min-width: 992px) {
        .sidebar-responsive {
            width: 280px !important;
            min-width: 280px !important;
            position: fixed !important;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 1000;
            overflow-y: auto;
        }
        body > .d-flex {
            padding-left: 280px;
        }
    }
    @media (max-width: 991.98px) {
        .sidebar-responsive {
            width: 100% !important;
            min-width: 100% !important;
            min-height: auto !important;
            position: static !important;
        }
        body > .d-flex {
            padding-left: 0 !important;
            flex-direction: column !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const currentPath = window.location.pathname;
        const subLinks = document.querySelectorAll('.sub-menu-link');
        subLinks.forEach(link => {
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('fw-bold', 'bg-white', 'bg-opacity-25', 'rounded');
                const parentCollapse = link.closest('.collapse');
                if (parentCollapse) {
                    parentCollapse.classList.add('show');
                }
            }
        });
    });
</script>
