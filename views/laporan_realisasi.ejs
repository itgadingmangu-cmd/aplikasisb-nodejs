<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Realisasi Anggaran - Tahun <%= pengaturan.tahun_aktif %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Title dengan Indikator Tahun Anggaran -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Laporan Realisasi Anggaran</h2>
                        <p class="text-muted mb-0">Monitoring perbandingan antara Pagu Anggaran (RAB) dan Pengeluaran Riil (Realisasi).</p>
                    </div>
                    <div>
                        <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
                            <i class="fas fa-calendar-alt me-1"></i> Tahun Anggaran: <%= pengaturan.tahun_aktif %>
                        </span>
                    </div>
                </div>

                <!-- Tabel Laporan Monitoring -->
                <div class="card p-4 bg-white shadow-sm">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="fas fa-chart-line text-success me-2"></i> Rekapitulasi Realisasi per Program Kerja (<%= pengaturan.tahun_aktif %>)
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>No</th>
                                    <th>Program Kerja & Bidang</th>
                                    <th class="text-end">Total RAB (Rencana)</th>
                                    <th class="text-end">Total Realisasi (Riil)</th>
                                    <th class="text-end">Sisa / Selisih</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (lembagaData && lembagaData.Prokers && lembagaData.Prokers.length > 0) { %>
                                    <% lembagaData.Prokers.forEach((p, index) => { %>
                                        <% 
                                            let totalRAB = 0;
                                            if (p.RincianBiayas) {
                                                totalRAB = p.RincianBiayas.reduce((sum, item) => sum + (parseFloat(item.total) || 0), 0);
                                            }

                                            let totalRealisasi = 0;
                                            if (p.Realisasis) {
                                                totalRealisasi = p.Realisasis.reduce((sum, item) => sum + (parseFloat(item.nominal_realisasi) || 0), 0);
                                            }

                                            let selisih = totalRAB - totalRealisasi;
                                        %>
                                        <tr>
                                            <td class="fw-bold text-muted"><%= index + 1 %></td>
                                            <td>
                                                <span class="fw-bold text-dark d-block"><%= p.nama_program %></span>
                                                <small class="text-muted"><%= p.Bidang ? p.Bidang.nama_bidang : 'Umum' %></small>
                                            </td>
                                            <td class="text-end fw-bold text-primary">Rp <%= totalRAB.toLocaleString('id-ID') %></td>
                                            <td class="text-end fw-bold text-success">Rp <%= totalRealisasi.toLocaleString('id-ID') %></td>
                                            <td class="text-end fw-bold <%= selisih < 0 ? 'text-danger' : 'text-secondary' %>">
                                                Rp <%= selisih.toLocaleString('id-ID') %>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                                    <%= p.status %>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a href="/lembaga-admin/proker/realisasi/<%= p.id %>" class="btn btn-outline-primary btn-sm shadow-sm" title="Kelola Realisasi">
                                                    <i class="fas fa-edit me-1"></i> Kelola Realisasi
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted small">
                                            <i class="fas fa-folder-open fa-2x mb-2 d-block text-secondary opacity-50"></i>
                                            Belum ada data program kerja atau realisasi terdaftar untuk Tahun Anggaran <%= pengaturan.tahun_aktif %>.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
