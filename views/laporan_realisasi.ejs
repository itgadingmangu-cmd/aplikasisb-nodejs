<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Realisasi Anggaran - Tahun <%= pengaturan.tahun_aktif %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
        @media print {
            .no-print { display: none !important; }
            body { background-color: #fff; }
            .card { box-shadow: none; border: none; padding: 0 !important; }
        }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Title dengan Indikator Tahun Anggaran & Tombol Cetak -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Laporan Realisasi Anggaran</h2>
                        <p class="text-muted mb-0">Monitoring perbandingan antara Pagu Anggaran (RAB) dan Pengeluaran Riil (Realisasi).</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
                            <i class="fas fa-calendar-alt me-1"></i> Tahun Anggaran: <%= pengaturan.tahun_aktif %>
                        </span>
                        <!-- Tombol Pemicu Modal Pengaturan Cetak -->
                        <button type="button" class="btn btn-dark shadow-sm no-print" data-bs-toggle="modal" data-bs-target="#modalCetakRealisasi">
                            <i class="fas fa-print me-1"></i> Cetak Laporan
                        </button>
                    </div>
                </div>

                <!-- Flash Messages -->
                <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                        <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <!-- Tabel Laporan Monitoring -->
                <div class="card p-4 bg-white shadow-sm">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="fas fa-chart-line text-success me-2"></i> Rekapitulasi Realisasi per Program Kerja (<%= pengaturan.tahun_aktif %>)
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>No</th>
                                    <th>Program Kerja & Bidang</th>
                                    <th class="text-end">Total RAB (Rencana)</th>
                                    <th class="text-end">Total Realisasi (Riil)</th>
                                    <th class="text-end">Sisa / Selisih</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center no-print">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (lembagaData && lembagaData.Prokers && lembagaData.Prokers.length > 0) { %>
                                    <% lembagaData.Prokers.forEach((p, index) => { %>
                                        <% 
                                            let totalRAB = 0;
                                            if (p.RincianBiayas) {
                                                totalRAB = p.RincianBiayas.reduce((sum, item) => sum + (parseFloat(item.total) || 0), 0);
                                            }

                                            let totalRealisasi = 0;
                                            if (p.Realisasis) {
                                                totalRealisasi = p.Realisasis.reduce((sum, item) => sum + (parseFloat(item.nominal_realisasi) || 0), 0);
                                            }

                                            let selisih = totalRAB - totalRealisasi;
                                        %>
                                        <tr>
                                            <td class="fw-bold text-muted"><%= index + 1 %></td>
                                            <td>
                                                <span class="fw-bold text-dark d-block"><%= p.nama_program %></span>
                                                <small class="text-muted"><%= p.Bidang ? p.Bidang.nama_bidang : 'Umum' %></small>
                                            </td>
                                            <td class="text-end fw-bold text-primary">Rp <%= totalRAB.toLocaleString('id-ID') %></td>
                                            <td class="text-end fw-bold text-success">Rp <%= totalRealisasi.toLocaleString('id-ID') %></td>
                                            <td class="text-end fw-bold <%= selisih < 0 ? 'text-danger' : 'text-secondary' %>">
                                                Rp <%= selisih.toLocaleString('id-ID') %>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                                    <%= p.status %>
                                                </span>
                                            </td>
                                            <td class="text-center no-print">
                                                <a href="/lembaga-admin/proker/realisasi/<%= p.id %>" class="btn btn-outline-primary btn-sm shadow-sm" title="Kelola Realisasi">
                                                    <i class="fas fa-edit me-1"></i> Kelola Realisasi
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted small">
                                            <i class="fas fa-folder-open fa-2x mb-2 d-block text-secondary opacity-50"></i>
                                            Belum ada data program kerja atau realisasi terdaftar untuk Tahun Anggaran <%= pengaturan.tahun_aktif %>.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- MODAL PENGATURAN CETAK LAPORAN REALISASI -->
    <div class="modal fade no-print" id="modalCetakRealisasi" tabindex="-1" aria-labelledby="modalCetakRealisasiLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="modalCetakRealisasiLabel">
                        <i class="fas fa-print text-primary me-2"></i> Konfigurasi Cetak Laporan Realisasi
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    
                    <!-- FILTER RENTANG WAKTU / PERIODE -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <label class="form-label small fw-bold text-dark mb-2">
                            <i class="fas fa-calendar-range text-primary me-1"></i> Periode Laporan (Opsional):
                        </label>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label text-muted" style="font-size: 11px;">Dari Tanggal</label>
                                <input type="date" class="form-control form-control-sm" id="modalStartDate">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted" style="font-size: 11px;">Sampai Tanggal</label>
                                <input type="date" class="form-control form-control-sm" id="modalEndDate">
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1" style="font-size: 11px;">*Kosongkan jika ingin mencetak rekap penuh satu tahun anggaran.</small>
                    </div>

                    <p class="text-muted small mb-2">Pilih format instan tanda tangan atau sesuaikan komponen di bawah ini:</p>
                    
                    <!-- DROPDOWN PRESET PILIHAN CEPAT -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Opsi Format Penandatanganan:</label>
                        <select class="form-select form-select-sm fw-semibold border-primary shadow-sm" id="presetTtdSelect">
                            <option value="">-- Pilih Format TTD Cepat --</option>
                            <option value="standar_digital">Otomatis Standar (Stempel & Gambar TTD Aktif)</option>
                            <option value="lengkap_digital">Otomatis Lengkap (+ 6 Dewan Pembina Wilayah)</option>
                            <option value="basah_standar">Kosongkan Standar (Hanya Kotak Kolom / Basah)</option>
                            <option value="basah_lengkap">Kosongkan Lengkap (+ 6 Pembina, Basah / Manual)</option>
                        </select>
                    </div>

                    <hr class="text-muted opacity-25">

                    <div class="vstack gap-2 bg-light p-3 rounded-3 border">
                        <% 
                            let labelUser = userSession.jabatan || userSession.role || 'Pejabat / Pembina';
                        %>

                        <!-- 1. Stempel Digital -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modalStempel" checked>
                            <label class="form-check-label small fw-semibold text-secondary" for="modalStempel">
                                <i class="fas fa-stamp text-warning me-1"></i> Tampilkan Stempel Digital Lembaga
                            </label>
                        </div>
                        <!-- 2. Gambar TTD Ketua -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modalTtdKetuaImg" checked>
                            <label class="form-check-label small fw-semibold text-secondary" for="modalTtdKetuaImg">
                                Tampilkan Gambar TTD Ketua Lembaga
                            </label>
                        </div>
                        <!-- 3. Gambar TTD Pejabat/Admin -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modalTtdPengajuImg" checked>
                            <label class="form-check-label small fw-semibold text-secondary" for="modalTtdPengajuImg">
                                Tampilkan Gambar TTD <%= labelUser %>
                            </label>
                        </div>
                        <hr class="text-muted opacity-50 my-1">
                        <!-- 4. Kolom TTD Ketua -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modalKolomKetua" checked>
                            <label class="form-check-label small fw-semibold text-dark" for="modalKolomKetua">
                                Kolom TTD Ketua Lembaga
                            </label>
                        </div>
                        <!-- 5. Kolom TTD Pembina / Pejabat -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modalKolomPengaju" checked>
                            <label class="form-check-label small fw-semibold text-dark" for="modalKolomPengaju">
                                Kolom TTD <%= labelUser %>
                            </label>
                        </div>
                        <!-- 6. Kolom 6 Pembina -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modalKolom6Pembina">
                            <label class="form-check-label small fw-semibold text-secondary" for="modalKolom6Pembina">
                                Kolom TTD 6 Pembina Wilayah
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-4 fw-semibold" data-bs-dismiss="modal">Batal</button>
                    <button type="button" class="btn btn-primary px-4 fw-semibold" id="btnProsesCetak">
                        <i class="fas fa-external-link-alt me-1"></i> Buka Pratinjau Cetak
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('presetTtdSelect').addEventListener('change', function() {
            const val = this.value;
            const stempel = document.getElementById('modalStempel');
            const ttdKetuaImg = document.getElementById('modalTtdKetuaImg');
            const ttdPengajuImg = document.getElementById('modalTtdPengajuImg');
            const kolomKetua = document.getElementById('modalKolomKetua');
            const kolomPengaju = document.getElementById('modalKolomPengaju');
            const kolom6Pembina = document.getElementById('modalKolom6Pembina');

            if (val === 'standar_digital') {
                if(stempel) stempel.checked = true;
                if(ttdKetuaImg) ttdKetuaImg.checked = true;
                if(ttdPengajuImg) ttdPengajuImg.checked = true;
                if(kolomKetua) kolomKetua.checked = true;
                if(kolomPengaju) kolomPengaju.checked = true;
                if(kolom6Pembina) kolom6Pembina.checked = false;
            } else if (val === 'lengkap_digital') {
                if(stempel) stempel.checked = true;
                if(ttdKetuaImg) ttdKetuaImg.checked = true;
                if(ttdPengajuImg) ttdPengajuImg.checked = true;
                if(kolomKetua) kolomKetua.checked = true;
                if(kolomPengaju) kolomPengaju.checked = true;
                if(kolom6Pembina) kolom6Pembina.checked = true;
            } else if (val === 'basah_standar') {
                if(stempel) stempel.checked = false;
                if(ttdKetuaImg) ttdKetuaImg.checked = false;
                if(ttdPengajuImg) ttdPengajuImg.checked = false;
                if(kolomKetua) kolomKetua.checked = true;
                if(kolomPengaju) kolomPengaju.checked = true;
                if(kolom6Pembina) kolom6Pembina.checked = false;
            } else if (val === 'basah_lengkap') {
                if(stempel) stempel.checked = false;
                if(ttdKetuaImg) ttdKetuaImg.checked = false;
                if(ttdPengajuImg) ttdPengajuImg.checked = false;
                if(kolomKetua) kolomKetua.checked = true;
                if(kolomPengaju) kolomPengaju.checked = true;
                if(kolom6Pembina) kolom6Pembina.checked = true;
            }
        });

        document.getElementById('btnProsesCetak').addEventListener('click', function() {
            const startDate = document.getElementById('modalStartDate').value;
            const endDate = document.getElementById('modalEndDate').value;
            
            const stempel = document.getElementById('modalStempel') ? document.getElementById('modalStempel').checked : true;
            const ttdKetuaImg = document.getElementById('modalTtdKetuaImg') ? document.getElementById('modalTtdKetuaImg').checked : true;
            const ttdPengajuImg = document.getElementById('modalTtdPengajuImg') ? document.getElementById('modalTtdPengajuImg').checked : true;
            const kolomKetua = document.getElementById('modalKolomKetua') ? document.getElementById('modalKolomKetua').checked : true;
            const kolomPengaju = document.getElementById('modalKolomPengaju') ? document.getElementById('modalKolomPengaju').checked : true;
            const kolom6Pembina = document.getElementById('modalKolom6Pembina') ? document.getElementById('modalKolom6Pembina').checked : false;

            const queryParams = new URLSearchParams({
                tanggal_mulai: startDate,
                tanggal_selesai: endDate,
                show_stempel: stempel,
                show_ttd_ketua_img: ttdKetuaImg,
                show_ttd_pengaju_img: ttdPengajuImg,
                show_ketua: kolomKetua,
                show_pengaju: kolomPengaju,
                show_pembina: kolom6Pembina
            });

            window.open('/lembaga-admin/realisasi/print?' + queryParams.toString(), '_blank');
        });
    </script>
</body>
</html>
