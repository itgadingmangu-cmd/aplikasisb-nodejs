<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekapitulasi Rincian Anggaran - Tahun <%= pengaturan.tahun_aktif %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Title dengan Indikator Tahun Anggaran -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Rekapitulasi Rincian Anggaran</h2>
                        <p class="text-muted mb-0">Master ringkasan anggaran dan komponen biaya dari seluruh Program Kerja lembaga.</p>
                    </div>
                    <div>
                        <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
                            <i class="fas fa-calendar-alt me-1"></i> Tahun Anggaran: <%= pengaturan.tahun_aktif %>
                        </span>
                    </div>
                </div>

                <!-- Kartu Statistik Total Anggaran Lembaga (Pemisahan Reguler & Insidentil) -->
                <% 
                    let totalAnggaranReguler = 0;
                    let totalAnggaranInsidentil = 0;

                    if (lembagaData && lembagaData.Prokers) {
                        lembagaData.Prokers.forEach(p => {
                            let prokerTotal = 0;
                            if (p.RincianBiayas) {
                                prokerTotal = p.RincianBiayas.reduce((sum, item) => sum + (parseFloat(item.total) || 0), 0);
                            }

                            if (!p.jenis || p.jenis === 'Reguler') {
                                totalAnggaranReguler += prokerTotal;
                            } else if (p.jenis === 'Insidentil') {
                                totalAnggaranInsidentil += prokerTotal;
                            }
                        });
                    }
                    let grandTotalAnggaran = totalAnggaranReguler + totalAnggaranInsidentil;
                %>
                <div class="row mb-4 g-3">
                    <div class="col-xl-4 col-md-6">
                        <div class="card p-3 bg-white border-start border-4 border-success shadow-sm h-100">
                            <span class="text-muted small fw-bold text-uppercase">Total Pagu Keseluruhan</span>
                            <h3 class="fw-bold text-success mt-1 mb-0">Rp <%= grandTotalAnggaran.toLocaleString('id-ID') %></h3>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="card p-3 bg-white border-start border-4 border-primary shadow-sm h-100">
                            <span class="text-muted small fw-bold text-uppercase">Total Anggaran Reguler (RAB)</span>
                            <h3 class="fw-bold text-primary mt-1 mb-0">Rp <%= totalAnggaranReguler.toLocaleString('id-ID') %></h3>
                        </div>
                    </div>
                    <div class="col-xl-4 col-md-6">
                        <div class="card p-3 bg-white border-start border-4 border-warning shadow-sm h-100">
                            <span class="text-muted small fw-bold text-uppercase">Total Anggaran Insidentil (Di Luar RAB)</span>
                            <h3 class="fw-bold text-warning mt-1 mb-0">Rp <%= totalAnggaranInsidentil.toLocaleString('id-ID') %></h3>
                        </div>
                    </div>
                </div>

                <!-- Tabel Master Rekapitulasi Proker & Anggaran Terkelompok -->
                <div class="card p-4 bg-white shadow-sm">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="fas fa-wallet text-primary me-2"></i> Daftar Rincian Anggaran per Program Kerja (<%= pengaturan.tahun_aktif %>)
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>No</th>
                                    <th>Program Kerja & Bidang</th>
                                    <th>Bulan Pelaksanaan</th>
                                    <th>Status</th>
                                    <th class="text-end">Total Anggaran (RAB)</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (lembagaData && lembagaData.Prokers && lembagaData.Prokers.length > 0) { %>
                                    <% 
                                        const prokerReguler = lembagaData.Prokers.filter(p => !p.jenis || p.jenis === 'Reguler');
                                        const prokerInsidentil = lembagaData.Prokers.filter(p => p.jenis === 'Insidentil');
                                        let nomorUrut = 1;
                                    %>

                                    <!-- KELOMPOK 1: REGULER -->
                                    <tr class="table-secondary fw-bold">
                                        <td colspan="6"><i class="fas fa-circle-check text-success me-1"></i> I. PROGRAM KERJA REGULER (SESUAI RAB UTAMA)</td>
                                    </tr>
                                    <% if (prokerReguler.length > 0) { %>
                                        <% prokerReguler.forEach((p) => { %>
                                            <% 
                                                let totalProker = 0;
                                                if (p.RincianBiayas && p.RincianBiayas.length > 0) {
                                                    totalProker = p.RincianBiayas.reduce((sum, item) => sum + (parseFloat(item.total) || 0), 0);
                                                }
                                            %>
                                            <tr>
                                                <td class="fw-bold text-muted"><%= nomorUrut++ %></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="fw-bold text-dark"><%= p.nama_program %></span>
                                                        <span class="badge bg-success text-white px-2 py-0" style="font-size: 10px;">Reguler</span>
                                                    </div>
                                                    <small class="text-muted"><%= p.Bidang ? p.Bidang.nama_bidang : 'Umum' %></small>
                                                </td>
                                                <td><%= p.waktu_pelaksanaan || '-' %></td>
                                                <td>
                                                    <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                                        <%= p.status %>
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold text-success">
                                                    Rp <%= totalProker.toLocaleString('id-ID') %>
                                                </td>
                                                <td class="text-center">
                                                    <a href="/lembaga-admin/proker/rab/<%= p.id %>" class="btn btn-outline-primary btn-sm" title="Lihat Rincian RAB">
                                                        <i class="fas fa-eye me-1"></i> Detail RAB
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center text-muted fst-italic py-2 small">Tidak ada program kerja reguler.</td>
                                        </tr>
                                    <% } %>

                                    <!-- KELOMPOK 2: INSIDENTIL -->
                                    <tr class="table-secondary fw-bold">
                                        <td colspan="6"><i class="fas fa-triangle-exclamation text-warning me-1"></i> II. KEGIATAN INSIDENTIL (DI LUAR RAB / TAMBAHAN)</td>
                                    </tr>
                                    <% if (prokerInsidentil.length > 0) { %>
                                        <% prokerInsidentil.forEach((p) => { %>
                                            <% 
                                                let totalProker = 0;
                                                if (p.RincianBiayas && p.RincianBiayas.length > 0) {
                                                    totalProker = p.RincianBiayas.reduce((sum, item) => sum + (parseFloat(item.total) || 0), 0);
                                                }
                                            %>
                                            <tr>
                                                <td class="fw-bold text-muted"><%= nomorUrut++ %></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="fw-bold text-dark"><%= p.nama_program %></span>
                                                        <span class="badge bg-warning text-dark px-2 py-0" style="font-size: 10px;">Insidentil</span>
                                                    </div>
                                                    <small class="text-muted"><%= p.Bidang ? p.Bidang.nama_bidang : 'Umum' %></small>
                                                </td>
                                                <td><%= p.waktu_pelaksanaan || '-' %></td>
                                                <td>
                                                    <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                                        <%= p.status %>
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold text-success">
                                                    Rp <%= totalProker.toLocaleString('id-ID') %>
                                                </td>
                                                <td class="text-center">
                                                    <a href="/lembaga-admin/proker/rab/<%= p.id %>" class="btn btn-outline-primary btn-sm" title="Lihat Rincian RAB">
                                                        <i class="fas fa-eye me-1"></i> Detail RAB
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center text-muted fst-italic py-2 small">Tidak ada kegiatan insidentil.</td>
                                        </tr>
                                    <% } %>

                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted small">
                                            <i class="fas fa-folder-open fa-2x mb-2 d-block text-secondary opacity-50"></i>
                                            Belum ada data anggaran atau program kerja terdaftar untuk Tahun Anggaran <%= pengaturan.tahun_aktif %>.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
