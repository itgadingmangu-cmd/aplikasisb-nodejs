<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rekapitulasi Rincian Anggaran Lembaga</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-4 min-vh-100">
            <div class="container-fluid">
                
                <!-- Header Title -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Rekapitulasi Rincian Anggaran</h2>
                        <p class="text-muted mb-0">Master ringkasan anggaran dan komponen biaya dari seluruh Program Kerja lembaga.</p>
                    </div>
                    <a href="/lembaga-admin" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Kembali ke Dashboard
                    </a>
                </div>

                <!-- Kartu Statistik Total Anggaran Lembaga -->
                <% 
                    let grandTotalAnggaran = 0;
                    if (lembagaData && lembagaData.Prokers) {
                        lembagaData.Prokers.forEach(p => {
                            if (p.RincianBiayas) {
                                grandTotalAnggaran += p.RincianBiayas.reduce((sum, item) => sum + (parseFloat(item.total) || 0), 0);
                            }
                        });
                    }
                %>
                <div class="row mb-4">
                    <div class="col-xl-4 col-md-6">
                        <div class="card p-3 bg-white border-start border-4 border-success">
                            <span class="text-muted small fw-bold text-uppercase">Total Pagu Anggaran Lembaga</span>
                            <h3 class="fw-bold text-success mt-1 mb-0">Rp <%= grandTotalAnggaran.toLocaleString('id-ID') %></h3>
                        </div>
                    </div>
                </div>

                <!-- Tabel Master Rekapitulasi Proker & Anggaran -->
                <div class="card p-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="fas fa-wallet text-primary me-2"></i> Daftar Rincian Anggaran per Program Kerja
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>No</th>
                                    <th>Program Kerja & Bidang</th>
                                    <th>Bulan Pelaksanaan</th>
                                    <th>Status</th>
                                    <th class="text-end">Total Anggaran (RAB)</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (lembagaData && lembagaData.Prokers && lembagaData.Prokers.length > 0) { %>
                                    <% lembagaData.Prokers.forEach((p, index) => { %>
                                        <% 
                                            let totalProker = 0;
                                            if (p.RincianBiayas && p.RincianBiayas.length > 0) {
                                                totalProker = p.RincianBiayas.reduce((sum, item) => sum + (parseFloat(item.total) || 0), 0);
                                            }
                                        %>
                                        <tr>
                                            <td class="fw-bold text-muted"><%= index + 1 %></td>
                                            <td>
                                                <span class="fw-bold text-dark d-block"><%= p.nama_program %></span>
                                                <small class="text-muted"><%= p.Bidang ? p.Bidang.nama_bidang : 'Umum' %></small>
                                            </td>
                                            <td><%= p.waktu_pelaksanaan || '-' %></td>
                                            <td>
                                                <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                                    <%= p.status %>
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                Rp <%= totalProker.toLocaleString('id-ID') %>
                                            </td>
                                            <td class="text-center">
                                                <a href="/lembaga-admin/proker/rab/<%= p.id %>" class="btn btn-outline-primary btn-sm" title="Lihat Rincian RAB">
                                                    <i class="fas fa-eye me-1"></i> Detail RAB
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted small">Belum ada data anggaran atau program kerja terdaftar.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
