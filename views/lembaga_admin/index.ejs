<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100 p-4">
            
            <!-- Header / Flash Message -->
            <div class="mb-4">
                <h2 class="fw-bold">Panel Kontrol Admin Lembaga</h2>
                <p class="text-muted">Kelola bidang operasional, pengurus, dan program kerja di bawah lembaga Anda.</p>
            </div>

            <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- Row 1: Manajemen Bidang & Pengurus -->
            <div class="row g-4 mb-4">
                <!-- Daftar Bidang Lembaga -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-sitemap me-2"></i> Daftar Bidang Lembaga</h5>
                            
                            <form action="/lembaga-admin/bidang" method="POST" class="mb-3">
                                <div class="input-group">
                                    <input type="text" name="nama_bidang" class="form-control" placeholder="Nama Bidang Baru (Cth: Sekretariat)" required>
                                    <button class="btn btn-primary" type="submit"><i class="fas fa-plus me-1"></i> Tambah</button>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>No</th>
                                            <th>Nama Bidang</th>
                                            <th class="text-center">Jumlah Proker</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (bidangs && bidangs.length > 0) { %>
                                            <% bidangs.forEach((b, index) => { %>
                                                <tr>
                                                    <td><%= index + 1 %></td>
                                                    <td class="fw-semibold"><%= b.nama_bidang %></td>
                                                    <td class="text-center"><span class="badge bg-secondary"><%= b.Prokers ? b.Prokers.length : 0 %></span></td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-3">Belum ada bidang terdaftar.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pengurus / User Bidang -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-users-cog me-2"></i> Pengurus / User Bidang</h5>
                            
                            <form action="/lembaga-admin/user" method="POST" class="mb-3">
                                <div class="mb-2">
                                    <input type="text" name="nama_lengkap" class="form-control form-control-sm" placeholder="Nama Lengkap Pengurus" required>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col">
                                        <input type="text" name="username" class="form-control form-control-sm" placeholder="Username Login" required>
                                    </div>
                                    <div class="col">
                                        <input type="password" name="password" class="form-control form-control-sm" placeholder="Password" required>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <select name="id_bidang" class="form-select form-select-sm" required>
                                        <option value="">-- Pilih Bidang Penugasan --</option>
                                        <% if (bidangs && bidangs.length > 0) { %>
                                            <% bidangs.forEach(b => { %>
                                                <option value="<%= b.id %>"><%= b.nama_bidang %></option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                    <button class="btn btn-success btn-sm" type="submit"><i class="fas fa-user-plus me-1"></i> Buat Akun</button>
                                </div>
                            </form>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle small">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Nama / User</th>
                                            <th>Bidang</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (users && users.length > 0) { %>
                                            <% users.forEach(u => { %>
                                                <tr>
                                                    <td>
                                                        <strong class="d-block"><%= u.nama_lengkap %></strong>
                                                        <span class="text-muted" style="font-size: 0.75rem;">@<%= u.username %></span>
                                                    </td>
                                                    <td><%= u.Bidang ? u.Bidang.nama_bidang : '-' %></td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="2" class="text-center text-muted py-3">Belum ada akun pengurus bidang.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2: Program Kerja & Anggaran -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-primary m-0"><i class="fas fa-tasks me-2"></i> Program Kerja & Anggaran Lembaga</h5>
                                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahProker">
                                    <i class="fas fa-plus me-1"></i> Tambah Proker
                                </button>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>No</th>
                                            <th>Nama Program Kerja</th>
                                            <th>Bidang</th>
                                            <th>Waktu Pelaksanaan</th>
                                            <th>Status</th>
                                            <th class="text-center">Aksi (Kelola Anggaran)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (prokers && prokers.length > 0) { %>
                                            <% prokers.forEach((p, index) => { %>
                                                <tr>
                                                    <td><%= index + 1 %></td>
                                                    <td class="fw-semibold"><%= p.nama_program %></td>
                                                    <td><%= p.Bidang ? p.Bidang.nama_bidang : '-' %></td>
                                                    <td><%= p.waktu_pelaksanaan %></td>
                                                    <td>
                                                        <span class="badge bg-warning text-dark"><%= p.status %></span>
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="/rincian-biaya?prokerId=<%= p.id %>" class="btn btn-outline-primary btn-sm">
                                                            <i class="fas fa-wallet me-1"></i> Rincian Biaya
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">Belum ada Program Kerja terdaftar di lembaga ini.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Modal Tambah Proker -->
    <div class="modal fade" id="modalTambahProker" tabindex="-1" aria-labelledby="modalTambahProkerLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form action="/lembaga-admin/proker" method="POST" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalTambahProkerLabel">Tambah Program Kerja</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nama Program Kerja</label>
                        <input type="text" name="nama_program" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bidang Terkait</label>
                        <select name="bidangId" class="form-select" required>
                            <option value="">-- Pilih Bidang --</option>
                            <% if (bidangs && bidangs.length > 0) { %>
                                <% bidangs.forEach(b => { %>
                                    <option value="<%= b.id %>"><%= b.nama_bidang %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Waktu Pelaksanaan</label>
                        <input type="text" name="waktu_pelaksanaan" class="form-control" placeholder="Cth: Triwulan I / Bulan Mei" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Deskripsi</label>
                        <textarea name="deskripsi" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary btn-sm">Simpan Proker</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
