<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Bidang & Uraian Tugas</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Memanggil Sidebar -->
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-4 min-vh-100">
            <div class="container-fluid">
                
                <!-- Header Title -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1">Manajemen Bidang & Uraian Tugas</h2>
                        <p class="text-muted mb-0">Kelola daftar bidang operasional beserta jobdesk atau tupoksi di lembaga Anda.</p>
                    </div>
                    <a href="/lembaga-admin" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> Kembali ke Dashboard
                    </a>
                </div>

                <div class="row g-4">
                    <!-- Form Tambah Bidang (Kolom Kiri) -->
                    <div class="col-lg-4">
                        <div class="card p-4 bg-white">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="fas fa-plus-circle text-primary me-2"></i> Tambah Bidang Baru
                            </h5>
                            <form action="/lembaga-admin/bidang/tambah" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Nama Bidang / Bagian</label>
                                    <input type="text" class="form-control" name="nama_bidang" placeholder="Contoh: Bidang Telematika" required>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-bold small">Uraian Tugas / Jobdesk</label>
                                    <textarea class="form-control" name="deskripsi_tugas" rows="6" placeholder="Masukkan poin-poin tupoksi..."></textarea>
                                    <div class="form-text small">Rincian tugas pokok dan fungsi bidang.</div>
                                </div>
                                <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                    <i class="fas fa-save me-1"></i> Simpan Bidang
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Tabel Daftar Bidang Terdaftar (Kolom Kanan) -->
                    <div class="col-lg-8">
                        <div class="card p-4 bg-white h-100">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="fas fa-sitemap text-success me-2"></i> Daftar Bidang Terdaftar
                            </h5>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th style="width: 8%;">No</th>
                                            <th style="width: 30%;">Nama Bidang</th>
                                            <th style="width: 42%;">Uraian Tugas Singkat</th>
                                            <th class="text-center" style="width: 20%;">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (lembagaData && lembagaData.Bidangs && lembagaData.Bidangs.length > 0) { %>
                                            <% lembagaData.Bidangs.forEach((b, index) => { %>
                                                <tr>
                                                    <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                    <td><span class="fw-bold text-dark"><%= b.nama_bidang %></span></td>
                                                    <td>
                                                        <span class="text-muted small" style="display: inline-block; max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= b.deskripsi_tugas %>">
                                                            <%= b.deskripsi_tugas ? b.deskripsi_tugas : '-' %>
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="d-flex justify-content-center gap-1">
                                                            <a href="/lembaga-admin/bidang/edit/<%= b.id %>" class="btn btn-outline-warning btn-sm" title="Edit">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            <a href="/lembaga-admin/bidang/hapus/<%= b.id %>" class="btn btn-outline-danger btn-sm" title="Hapus" onclick="return confirm('Yakin ingin menghapus bidang ini?');">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted small">Belum ada bidang terdaftar.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
