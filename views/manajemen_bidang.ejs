<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Bidang & Uraian Tugas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <%- include('partials/sidebar') %>

        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">

                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">Manajemen Bidang & Uraian Tugas</h2>
                    <p class="text-muted mb-0">Kelola daftar bidang, tupoksi, serta akun login pengurus bidang (berlaku multi-tahun selama tidak ada perubahan).</p>
                </div>

                <% if (locals.success_msg && success_msg) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (locals.error_msg && error_msg) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <% if (typeof generatedBidangUsers !== 'undefined' && Array.isArray(generatedBidangUsers) && generatedBidangUsers.length > 0) { %>
                    <div class="card p-4 bg-white border-start border-4 border-success mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <h5 class="fw-bold text-success mb-0">
                                <i class="fas fa-key me-2"></i> Kredensial Akun Bidang Baru (Salin Sekarang)
                            </h5>
                            <span class="badge bg-warning text-dark">Ditampilkan sekali demi keamanan</span>
                        </div>
                        <p class="text-muted small mb-3">Password hanya ditampilkan saat dibuat/digenerate. Akun tetap aktif lintas tahun selama tidak ada perubahan pengurus.</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr class="small">
                                        <th>Bidang</th>
                                        <th>Nama Akun</th>
                                        <th>Username</th>
                                        <th>Password</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% generatedBidangUsers.forEach((item) => { %>
                                        <tr>
                                            <td class="fw-bold"><%= item.bidang %></td>
                                            <td><%= item.nama_lengkap %></td>
                                            <td><code><%= item.username %></code></td>
                                            <td><code><%= item.password %></code></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } %>

                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="card p-4 bg-white">
                            <h5 class="fw-bold text-dark mb-3">
                                <i class="fas fa-plus-circle text-primary me-2"></i> Tambah Bidang Baru
                            </h5>
                            <form action="/lembaga-admin/bidang/tambah" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Nama Bidang / Bagian</label>
                                    <input type="text" class="form-control" name="nama_bidang" placeholder="Contoh: Bidang Telematika" required>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-bold small">Uraian Tugas / Jobdesk</label>
                                    <textarea class="form-control" name="deskripsi_tugas" rows="6" placeholder="Masukkan poin-poin tupoksi..."></textarea>
                                    <div class="form-text small">Rincian tugas pokok dan fungsi bidang.</div>
                                </div>
                                <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                    <i class="fas fa-save me-1"></i> Simpan Bidang
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="col-lg-8">
                        <div class="card p-4 bg-white h-100">
                            <form id="formGenerateBidangUsers" action="/lembaga-admin/bidang/generate-users" method="POST">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                    <h5 class="fw-bold text-dark mb-0">
                                        <i class="fas fa-sitemap text-success me-2"></i> Daftar Bidang & Akun Pengurus
                                    </h5>
                                    <button type="submit" class="btn btn-success btn-sm fw-bold" onclick="return confirm('Generate akun & password untuk bidang yang belum memiliki akun?');">
                                        <i class="fas fa-user-plus me-1"></i> Generate User & Password
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr class="small text-uppercase">
                                                <th style="width: 5%;">
                                                    <input type="checkbox" class="form-check-input" id="checkAllBidang" title="Pilih semua">
                                                </th>
                                                <th style="width: 6%;">No</th>
                                                <th style="width: 25%;">Nama Bidang</th>
                                                <th style="width: 28%;">Akun Pengurus</th>
                                                <th style="width: 18%;">Uraian Tugas</th>
                                                <th class="text-center" style="width: 18%;">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (lembagaData && lembagaData.Bidangs && lembagaData.Bidangs.length > 0) { %>
                                                <% lembagaData.Bidangs.forEach((b, index) => { %>
                                                    <% const pengurusUser = Array.isArray(b.Users) ? (b.Users.find(u => u.role === 'pengurus_bidang') || b.Users[0] || null) : null; %>
                                                    <tr>
                                                        <td>
                                                            <% if (!pengurusUser) { %>
                                                                <input type="checkbox" class="form-check-input bidang-checkbox" name="bidang_ids" value="<%= b.id %>">
                                                            <% } %>
                                                        </td>
                                                        <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                        <td><span class="fw-bold text-dark"><%= b.nama_bidang %></span></td>
                                                        <td>
                                                            <% if (pengurusUser) { %>
                                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                                    <i class="fas fa-user-check me-1"></i> <%= pengurusUser.username %>
                                                                </span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary-subtle text-secondary">Belum ada akun</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <span class="text-muted small" style="display: inline-block; max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= b.deskripsi_tugas %>">
                                                                <%= b.deskripsi_tugas ? b.deskripsi_tugas : '-' %>
                                                            </span>
                                                        </td>
                                                        <td class="text-center">
                                                            <div class="d-flex justify-content-center gap-1">
                                                                <% if (!pengurusUser) { %>
                                                                    <button type="button"
                                                                        class="btn btn-outline-primary btn-sm btn-buat-akun-satu"
                                                                        data-bidang-id="<%= b.id %>"
                                                                        data-bidang-nama="<%= b.nama_bidang %>"
                                                                        title="Buat Akun Satu per Satu">
                                                                        <i class="fas fa-key"></i>
                                                                    </button>
                                                                <% } %>
                                                                <a href="/lembaga-admin/bidang/edit/<%= b.id %>" class="btn btn-outline-warning btn-sm" title="Edit">
                                                                    <i class="fas fa-edit"></i>
                                                                </a>
                                                                <a href="/lembaga-admin/bidang/hapus/<%= b.id %>" class="btn btn-outline-danger btn-sm" title="Hapus" onclick="return confirm('Yakin ingin menghapus bidang ini?');">
                                                                    <i class="fas fa-trash-alt"></i>
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-4 text-muted small">Belum ada bidang terdaftar.</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Modal Buat Akun Satu per Satu -->
    <div class="modal fade" id="modalBuatAkunBidang" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form id="formBuatAkunSatu" method="POST" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fas fa-user-plus text-primary me-2"></i> Buat Akun Bidang</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Bidang</label>
                        <input type="text" id="modalBidangNama" class="form-control bg-light" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Nama Pengurus / Akun</label>
                        <input type="text" name="nama_lengkap" id="modalNamaLengkap" class="form-control" placeholder="Otomatis: Pengurus [Nama Bidang]">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Username</label>
                        <input type="text" name="username" id="modalUsername" class="form-control" placeholder="Kosongkan untuk generate otomatis">
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold small">Password</label>
                        <input type="text" name="password" id="modalPassword" class="form-control" placeholder="Kosongkan untuk generate password acak">
                        <div class="form-text small">Akun berlaku multi-tahun selama tidak ada perubahan pengurus.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold"><i class="fas fa-check me-1"></i> Simpan Akun</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const checkAll = document.getElementById('checkAllBidang');
        if (checkAll) {
            checkAll.addEventListener('change', function () {
                document.querySelectorAll('.bidang-checkbox').forEach((cb) => {
                    cb.checked = checkAll.checked;
                });
            });
        }

        const modalEl = document.getElementById('modalBuatAkunBidang');
        const formSatu = document.getElementById('formBuatAkunSatu');
        const modalBidangNama = document.getElementById('modalBidangNama');
        const modalNamaLengkap = document.getElementById('modalNamaLengkap');
        const modalUsername = document.getElementById('modalUsername');
        const modalPassword = document.getElementById('modalPassword');

        document.querySelectorAll('.btn-buat-akun-satu').forEach((btn) => {
            btn.addEventListener('click', function () {
                const id = this.getAttribute('data-bidang-id');
                const nama = this.getAttribute('data-bidang-nama') || '';
                formSatu.action = '/lembaga-admin/bidang/buat-user/' + id;
                modalBidangNama.value = nama;
                modalNamaLengkap.value = 'Pengurus ' + nama;
                modalUsername.value = '';
                modalPassword.value = '';
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
            });
        });
    </script>
</body>
</html>
