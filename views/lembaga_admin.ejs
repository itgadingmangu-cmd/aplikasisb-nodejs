<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Panel Kontrol Admin Lembaga' %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .icon-box {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
        }

        /* --- PERBAIKAN RESPONSIF MURNI (TANPA MERUBAH STRUKTUR/FUNGSI LAIN) --- */
        
        /* 1. Tampilan Laptop / Desktop: Mengunci agar konten utama fleksibel di samping sidebar */
        @media (min-width: 992px) {
            .d-flex#wrapper {
                flex-direction: row !important;
            }
            .flex-grow-1 {
                width: calc(100% - 280px) !important;
                min-width: 0 !important; /* Mencegah elemen flex meluber */
            }
        }

        /* 2. Tampilan HP / Mobile: Mengubah arah flex menjadi ke bawah secara rapi */
        @media (max-width: 991.98px) {
            .d-flex#wrapper {
                flex-direction: column !important;
            }
            .flex-grow-1 {
                width: 100% !important;
            }
        }
    </style>
</head>
<body class="bg-light">

    <% 
        // Deklarasi Global untuk View ini agar bisa diakses di seluruh baris kode bawahnya
        let jbt = (typeof userSession !== 'undefined' && userSession.jabatan) ? String(userSession.jabatan).toLowerCase() : '';
        let isBendaharaUser = jbt.includes('bendahara') || (typeof userSession !== 'undefined' && userSession.role === 'admin_lembaga');
    %>

    <div class="d-flex flex-column flex-lg-row min-vh-100" id="wrapper">
        <!-- Sidebar -->
        <%- include('partials/sidebar') %>

        <!-- Konten Utama Dashboard Lembaga -->
        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
               <!-- Header Title & Tombol Aksi Kanan Atas -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-lg-center mb-4 gap-3">
    
    <!-- Bagian Teks Kiri -->
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <% if (isBendaharaUser) { %>
                Panel Bendahara Utama (Pusat Keuangan)
            <% } else if (typeof userSession !== 'undefined' && userSession.id_bidang) { %>
                Panel Bidang: <%= (typeof bidangs !== 'undefined' && bidangs.length > 0) ? bidangs[0].nama_bidang : (userSession.nama_bidang || 'Sekretaris') %>
            <% } else { %>
                Panel Kontrol Admin Lembaga
            <% } %>
        </h2>
        <p class="text-muted mb-0">
            <% if (isBendaharaUser) { %>
                Monitor rekapitulasi anggaran, pagu RAB, dan realisasi riil lintas bidang secara terpusat.
            <% } else if (typeof userSession !== 'undefined' && userSession.id_bidang) { %>
                Kelola program kerja, usulan kegiatan, dan laporan bidang Anda di bawah lembaga.
            <% } else { %>
                Kelola bidang operasional, pengurus, dan program kerja di bawah lembaga Anda.
            <% } %>
        </p>
    </div>

    <!-- Bagian Tombol Aksi Kanan (Berjajar rapi & otomatis turun ke bawah jika layar sempit) -->
    <div class="d-inline-flex align-items-center gap-2 flex-wrap">
        
        <!-- Tombol Akses Cepat Khusus Rekapitulasi Bendahara Utama -->
        <% if (isBendaharaUser || (typeof userSession !== 'undefined' && (userSession.role === 'admin_lembaga' || userSession.role === 'superadmin'))) { %>
            <a href="/lembaga-admin/bendahara/rekapitulasi" class="btn btn-warning btn-sm fw-bold shadow-sm px-3 py-2">
                <i class="fas fa-chart-pie me-1"></i> Rekapitulasi Pusat
            </a>
        <% } %>

        <!-- Tombol Beranda / Kembali ke Pusat (Muncul jika Superadmin yang akses) -->
        <% if (typeof userSession !== 'undefined' && userSession.role === 'superadmin') { %>
            <a href="/" class="btn btn-light btn-sm fw-bold border text-dark px-3 py-2 shadow-sm">
                <i class="fas fa-home me-1 text-primary"></i> Home Pusat
            </a>
        <% } %>

        <!-- Dropdown Switch Organization di Kanan Atas -->
        <% if (typeof userSession !== 'undefined' && userSession.role === 'superadmin' && typeof listLembaga !== 'undefined') { %>
            <div class="dropdown">
                <button class="btn btn-primary btn-sm dropdown-toggle fw-bold px-3 py-2 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #0d6efd;">
                    <i class="fas fa-landmark me-1"></i> 
                    <% 
                        let activeOrgName = "Pilih Lembaga";
                        let foundOrg = listLembaga.find(o => o.id == userSession.activeLembagaId);
                        if (foundOrg) activeOrgName = foundOrg.nama_organisasi;
                        else if (typeof lembagaData !== 'undefined' && lembagaData) activeOrgName = lembagaData.nama_organisasi;
                    %>
                    <%= activeOrgName %>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width: 220px;">
                    <li><h6 class="dropdown-header small text-uppercase text-muted">Switch Organization</h6></li>
                    <% listLembaga.forEach(org => { %>
                        <li>
                            <a class="dropdown-item py-2 small fw-semibold <%= (userSession.activeLembagaId == org.id) ? 'active' : '' %>" href="/superadmin/pilih-lembaga/<%= org.id %>">
                                <i class="fas fa-building me-2 text-primary"></i> <%= org.nama_organisasi %>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <!-- Badge Tahun Aktif -->
        <span class="badge bg-primary px-3 py-2 rounded-pill fs-6 shadow-sm">
            <i class="fas fa-calendar-alt me-1"></i> TA: <%= (typeof pengaturan !== 'undefined' && pengaturan.tahun_aktif) ? pengaturan.tahun_aktif : '2026' %>
        </span>

        <!-- Tombol Keluar / Logout -->
        <a href="/logout" class="item-link btn btn-outline-danger btn-sm fw-bold px-3 py-2 shadow-sm">
            <i class="fas fa-sign-out-alt me-1"></i> Keluar
        </a>
    </div>
</div>

<!-- ========================================================= -->
<!-- WIDGET STATUS TANDA TANGAN PRIBADI (UNTUK AKUN BIDANG/USER) -->
<!-- ========================================================= -->
<div class="card bg-white border-start border-primary border-4 p-3 mb-4 shadow-sm">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-box bg-primary bg-opacity-10 text-primary fs-4 me-3">
                <i class="fas fa-file-signature"></i>
            </div>
            <div>
                <h6 class="fw-bold text-dark mb-1">Tanda Tangan Digital (TTD) Pribadi Anda</h6>
                <p class="text-muted small mb-0">
                    <% if (typeof userSession !== 'undefined' && userSession.ttd) { %>
                        <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Tanda tangan sudah diunggah dan otomatis diterapkan pada dokumen cetak proposal Anda.</span>
                    <% } else { %>
                        <span class="text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i> Anda belum mengunggah tanda tangan digital pribadi. Segera unggah agar proposal Anda menampilkan TTD yang benar.</span>
                    <% } %>
                </p>
            </div>
        </div>
        <div>
            <a href="/lembaga-admin/profile" class="btn btn-primary btn-sm fw-bold px-3 py-2 shadow-sm text-nowrap">
                <i class="fas fa-upload me-1"></i> Kelola / Upload TTD
            </a>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- WIDGET NOTIFIKASI & RIWAYAT STATUS (COMPACT & SIMPLE)     -->
<!-- ========================================================= -->
<div class="card p-3 bg-white mb-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold text-dark mb-0">
            <i class="fas fa-bell text-primary me-2"></i> Notifikasi & Status Proposal / LPJ Terbaru
        </h6>
        <% if (typeof totalPendingPencairan !== 'undefined' && totalPendingPencairan > 0) { %>
            <a href="/lembaga-admin/proposal" class="badge bg-info text-dark text-decoration-none px-2 py-1">
                <i class="fas fa-wallet me-1"></i> <%= totalPendingPencairan %> Menunggu Pencairan
            </a>
        <% } else { %>
            <span class="badge bg-secondary rounded-pill">Ringkasan Aktivitas</span>
        <% } %>
    </div>
    
    <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
        <table class="table table-sm table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th style="width: 35%;">Program Kerja / Kegiatan</th>
                    <th style="width: 20%;">Status Terkini</th>
                    <th style="width: 35%;">Catatan / Keterangan</th>
                    <th style="width: 10%;" class="text-end">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% let hasNotif = false; %>
                <% if (typeof prokers !== 'undefined' && prokers.length > 0) { %>
                    <% prokers.forEach(p => { %>
                        <% if (p.Proposal && p.Proposal.status && p.Proposal.status !== 'Draft') { %>
                            <% hasNotif = true; %>
                            <tr>
                                <td class="fw-bold text-dark"><%= p.nama_program || p.nama_proker %></td>
                                <td>
                                    <% 
                                        let badgeClass = 'bg-secondary';
                                        let statusText = p.Proposal.status;
                                        if (statusText === 'Disetujui') {
                                            badgeClass = 'bg-primary'; // Warna Biru untuk Disetujui
                                        } else if (statusText === 'Dana Dicairkan') {
                                            badgeClass = 'bg-success'; // Warna Hijau untuk Dana Dicairkan
                                        } else if (statusText === 'Diajukan') {
                                            badgeClass = 'bg-warning text-dark';
                                        } else if (statusText === 'Perlu Revisi' || statusText === 'Direvisi' || statusText === 'Dana Ditolak') {
                                            badgeClass = 'bg-danger';
                                        }
                                    %>
                                    <span class="badge <%= badgeClass %> px-2 py-1"><%= statusText %></span>
                                </td>
                                <td class="text-muted text-truncate" style="max-width: 200px;" title="<%= p.Proposal.catatan_revisi || 'Sesuai prosedur' %>">
                                    <%= p.Proposal.catatan_revisi || '-' %>
                                </td>
                                <td class="text-end">
                                    <a href="/lembaga-admin/proker/proposal/<%= p.id %>" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;">
                                        <i class="fas fa-arrow-right"></i> Detail
                                    </a>
                                </td>
                            </tr>
                        <% } %>
                    <% }) %>
                <% } %>

                <% if (!hasNotif) { %>
                    <tr>
                        <td colspan="4" class="text-center py-3 text-muted fst-italic">Belum ada aktivitas atau status proposal baru.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Flash Messages / Notifikasi Sukses Diagnostik -->
<% if (typeof success_msg !== 'undefined' && success_msg) { %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: #d1e7dd; color: #0f5132; border-left: 5px solid #198754 !important;">
        <div class="d-flex align-items-center">
            <i class="fas fa-check-circle fa-lg me-2 text-success"></i>
            <div>
                <%= success_msg %>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg) { %>
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-circle fa-lg me-2 text-danger"></i>
            <div>
                <%= error_msg %>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<!-- Banner Diagnostik Sisi Lembaga (Tampil Dinamis saat kartu diklik) -->
<% if (typeof diagnosticMessage !== 'undefined' && diagnosticMessage) { %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: #d1e7dd; color: #0f5132; border-left: 5px solid #198754 !important;">
        <div class="d-flex align-items-center">
            <i class="fas fa-check-circle fa-lg me-2 text-success"></i>
            <div>
                <strong><%= diagnosticMessage %></strong>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

                <!-- 1. Kartu Statistik & Dashboard Eksekutif Keuangan -->
    <div class="row g-3 mb-4">
        <!-- Card Lembaga Aktif (Interaktif untuk Diagnostik) -->
        <div class="col-xl col-md-4">
            <a href="/lembaga-admin/diagnostik/cek" class="text-decoration-none">
                <div class="card p-3 bg-white border-start border-primary border-4 h-100 shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="icon-box bg-primary bg-opacity-10 text-primary fs-4 me-3">
                            <i class="fas fa-landmark"></i>
                        </div>
                        <div>
    <span class="text-muted small d-block">
        <% if (typeof userSession !== 'undefined' && userSession.id_bidang) { %>
            Bidang Aktif <i class="fas fa-hand-pointer ms-1 small"></i>
        <% } else { %>
            Lembaga Aktif <i class="fas fa-hand-pointer ms-1 small"></i>
        <% } %>
    </span>
    <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 140px;" title="<%= (typeof userSession !== 'undefined' && userSession.id_bidang && typeof bidang !== 'undefined' && bidang) ? bidang.nama_bidang : ((typeof lembagaData !== 'undefined' && lembagaData) ? lembagaData.nama_organisasi : 'Lembaga') %>">
        <% if (typeof userSession !== 'undefined' && userSession.id_bidang && typeof bidang !== 'undefined' && bidang) { %>
            <%= bidang.nama_bidang %>
        <% } else { %>
            <%= (typeof lembagaData !== 'undefined' && lembagaData) ? lembagaData.nama_organisasi : 'Lembaga' %>
        <% } %>
    </h6>
    <small class="text-muted" style="font-size: 0.7rem;">Klik untuk tes modul OK</small>
</div>
                    </div>
                </div>
            </a>
        </div>

                    <!-- Card Jumlah Bidang -->
                    <div class="col-xl col-md-4">
                        <div class="card p-3 bg-white border-start border-success border-4 h-100">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-success bg-opacity-10 text-success fs-4 me-3">
                                    <i class="fas fa-sitemap"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Total Bidang</span>
                                    <h5 class="fw-bold text-dark mb-0">
                                        <%= (typeof bidangs !== 'undefined' && bidangs) ? bidangs.length : 0 %> Bidang
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Total Anggaran (Pagu RAB) -->
                    <div class="col-xl col-md-4">
                        <div class="card p-3 bg-white border-start border-primary border-4 h-100">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-primary bg-opacity-10 text-primary fs-4 me-3">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Total Pagu RAB</span>
                                    <h5 class="fw-bold text-primary mb-0" style="font-size: 1.05rem;">
                                        Rp <%= typeof totalAnggaranLembaga !== 'undefined' ? totalAnggaranLembaga.toLocaleString('id-ID') : '0' %>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Total Realisasi Riil -->
                    <div class="col-xl col-md-6">
                        <div class="card p-3 bg-white border-start border-success border-4 h-100">
                            <div class="d-flex align-items-center">
                                <div class="icon-box bg-success bg-opacity-10 text-success fs-4 me-3">
                                    <i class="fas fa-receipt"></i>
                                </div>
                                <div>
                                    <span class="text-muted small d-block">Total Realisasi Riil</span>
                                    <h5 class="fw-bold text-success mb-0" style="font-size: 1.05rem;">
                                        Rp <%= typeof totalRealisasiLembaga !== 'undefined' ? totalRealisasiLembaga.toLocaleString('id-ID') : '0' %>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Persentase Serapan Anggaran (Progress Bar) -->
                    <div class="col-xl col-md-6">
                        <div class="card p-3 bg-white border-start border-warning border-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted small fw-bold">Serapan Anggaran</span>
                                <span class="badge bg-warning text-dark fw-bold"><%= typeof persentaseSerapan !== 'undefined' ? persentaseSerapan : '0' %>%</span>
                            </div>
                            <div class="progress mt-1" style="height: 10px;">
                                <% let pVal = typeof persentaseSerapan !== 'undefined' ? parseFloat(persentaseSerapan) : 0; %>
                                <div class="progress-bar bg-success" role="progressbar" style="width: <%= pVal > 100 ? 100 : pVal %>%" aria-valuenow="<%= pVal %>" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small class="text-muted mt-1" style="font-size: 0.7rem;">Perbandingan Realisasi vs Pagu RAB</small>
                        </div>
                    </div>
                </div>

                <!-- 2. Matriks Program Kerja & Anggaran (Bulan 1 - 12) -->
                <div class="card p-4 bg-white mb-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="fas fa-tasks text-warning me-2"></i> Matriks Program Kerja & Anggaran Lembaga (Bulan 1 - 12)
                        </h5>
                        <!-- TOMBOL EKSPOR LAPORAN (EXCEL & PDF) -->
                        <div class="d-flex gap-2">
                            <a href="/lembaga-admin/ekspor/excel" class="btn btn-success btn-sm fw-bold shadow-sm">
                                <i class="fas fa-file-excel me-1"></i> Unduh Excel (.xlsx)
                            </a>
                            <a href="/lembaga-admin/ekspor/pdf" target="_blank" class="btn btn-danger btn-sm fw-bold shadow-sm">
                                <i class="fas fa-file-pdf me-1"></i> Cetak / Simpan PDF Resmi
                            </a>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0 text-center">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th rowspan="2" class="align-middle py-3" style="width: 4%;">No</th>
                                    <th rowspan="2" class="align-middle py-3 text-start" style="width: 26%;">Nama Program Kerja</th>
                                    <th rowspan="2" class="align-middle py-3" style="width: 15%;">Bidang</th>
                                    <th colspan="12" class="py-2">Bulan Pelaksanaan</th>
                                    <th rowspan="2" class="align-middle py-3" style="width: 10%;">Status</th>
                                    <th rowspan="2" class="align-middle py-3" style="width: 10%;">Aksi</th>
                                </tr>
                                <tr class="small">
                                    <% for(let m = 1; m <= 12; m++) { %>
                                        <th class="py-2" style="width: 3%;"><%= m %></th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof prokers !== 'undefined' && prokers && prokers.length > 0) { %>
                                    <% prokers.forEach((proker, index) => { %>
                                        <tr>
                                            <td class="fw-bold text-muted"><%= index + 1 %></td>
                                            <td class="text-start">
                                                <span class="fw-bold text-dark"><%= proker.nama_proker || proker.nama_program || 'Program Kerja' %></span>
                                            </td>
                                            <td>
                                                <span class="text-muted small"><%= proker.Bidang ? proker.Bidang.nama_bidang : '-' %></span>
                                            </td>
                                            
                                            <% 
                                                let activeMonths = [];
                                                if (proker.waktu_pelaksanaan) {
                                                    activeMonths = String(proker.waktu_pelaksanaan).split(',').map(item => item.trim());
                                                }
                                            %>
                                            <% for(let m = 1; m <= 12; m++) { %>
                                                <td>
                                                    <% if (activeMonths.includes(String(m))) { %>
                                                        <span class="text-success fw-bold">✔</span>
                                                    <% } else { %>
                                                        <span class="text-muted opacity-25">-</span>
                                                    <% } %>
                                                </td>
                                            <% } %>

                                            <td>
                                                <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">
                                                    <%= (proker.Proposal && proker.Proposal.status) ? proker.Proposal.status : (proker.status || 'Aktif') %>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="/lembaga-admin/proker/proposal/<%= proker.id %>" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-eye"></i> Kelola
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="17" class="text-center py-4 text-muted">
                                            <i class="fas fa-folder-open fs-3 d-block mb-2 text-secondary opacity-50"></i>
                                            Belum ada Program Kerja terdaftar di lembaga ini.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 3. Bagian Tabel Bawah: Daftar Bidang & Pengurus -->
                <div class="row g-4 mb-4">
                    <!-- TABEL DAFTAR BIDANG -->
                    <div class="col-lg-6">
                        <div class="card p-4 bg-white h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="fas fa-sitemap text-primary me-2"></i> Daftar Bidang & Tugas
                                </h5>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th scope="col" style="width: 10%;">No</th>
                                            <th scope="col" style="width: 45%;">Nama Bidang</th>
                                            <th scope="col" style="width: 45%;">Uraian Tugas Singkat</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof bidangs !== 'undefined' && bidangs && bidangs.length > 0) { %>
                                            <% bidangs.forEach((bidang, index) => { %>
                                                <tr>
                                                    <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                    <td><span class="fw-bold text-dark"><%= bidang.nama_bidang %></span></td>
                                                    <td>
                                                        <span class="text-muted small" title="<%= bidang.deskripsi_tugas %>">
                                                            <%= bidang.deskripsi_tugas ? bidang.deskripsi_tugas : '-' %>
                                                        </span>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center py-3 text-muted small">Belum ada bidang terdaftar.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- TABEL PENGURUS / USER BIDANG -->
                    <div class="col-lg-6">
                        <div class="card p-4 bg-white h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="fas fa-user-shield text-success me-2"></i> Pengurus / User Bidang
                                </h5>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th scope="col" style="width: 15%;">No</th>
                                            <th scope="col" style="width: 50%;">Nama / Username</th>
                                            <th scope="col" style="width: 35%;">Bidang</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                                            <% users.forEach((usr, index) => { %>
                                                <tr>
                                                    <td class="fw-bold text-muted"><%= index + 1 %></td>
                                                    <td>
                                                        <span class="fw-bold text-dark d-block"><%= usr.nama_lengkap %></span>
                                                        <small class="text-muted">@<%= usr.username %></small>
                                                    </td>
                                                    <td><%= usr.Bidang ? usr.Bidang.nama_bidang : '-' %></td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center py-3 text-muted small">Belum ada akun pengurus.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
