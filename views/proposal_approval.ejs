<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Persetujuan Proposal & RAB</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card { border: none; border-radius: 12px; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex flex-column flex-lg-row min-vh-100">
        <%- include('partials/sidebar') %>
        <div class="flex-grow-1 p-3 p-md-4">
            <div class="container-fluid px-0">
                
                <!-- Header Navigasi -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold text-dark mb-1"><i class="fas fa-check-double text-primary me-2"></i> Persetujuan Proposal & RAB</h2>
                        <p class="text-muted mb-0">Tahun Anggaran: <span class="fw-semibold text-dark"><%= pengaturan.tahun_aktif %></span></p>
                    </div>
                </div>

                <!-- Notifikasi -->
                <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i> <%= success_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <!-- Tabel Daftar Proposal -->
                <div class="card p-4 bg-white">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th width="5%">No</th>
                                    <th>Program Kerja</th>
                                    <th>Bidang</th>
                                    <th>Tema Proposal</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center" width="25%">Aksi Pimpinan</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (prokers && prokers.length > 0) { %>
                                    <% let no = 1; %>
                                    <% prokers.forEach(proker => { %>
                                        <% if (proker.Proposal) { %>
                                            <tr>
                                                <td><%= no++ %></td>
                                                <td class="fw-semibold"><%= proker.nama_program %></td>
                                                <td><span class="badge bg-secondary"><%= proker.Bidang ? proker.Bidang.nama_bidang : 'Umum' %></span></td>
                                                <td><%= proker.Proposal.tema || '-' %></td>
                                                <td class="text-center">
                                                    <% if (proker.Proposal.status === 'Disetujui') { %>
                                                        <span class="badge bg-success px-3 py-2">Disetujui</span>
                                                    <% } else if (proker.Proposal.status === 'Diajukan') { %>
                                                        <span class="badge bg-warning text-dark px-3 py-2">Menunggu Persetujuan</span>
                                                    <% } else if (proker.Proposal.status === 'Direvisi') { %>
                                                        <span class="badge bg-danger px-3 py-2">Perlu Revisi</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary px-3 py-2"><%= proker.Proposal.status %></span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <!-- Tombol Pratinjau Proposal -->
                                                    <a href="/lembaga-admin/proker/proposal/print/<%= proker.Proposal.id %>" target="_blank" class="btn btn-outline-info btn-sm me-1" title="Pratinjau Dokumen">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    
                                                    <!-- Form Aksi Setujui / Revisi -->
                                                    <form action="/lembaga-admin/proker/proposal/approval/<%= proker.Proposal.id %>" method="POST" class="d-inline">
                                                        <button type="submit" name="status" value="Disetujui" class="btn btn-success btn-sm me-1" title="Setujui Proposal">
                                                            <i class="fas fa-check"></i> Setujui
                                                        </button>
                                                        <button type="submit" name="status" value="Direvisi" class="btn btn-warning btn-sm text-dark" title="Minta Revisi">
                                                            <i class="fas fa-redo"></i> Revisi
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% } %>
                                    <% %>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Belum ada data proposal yang tersedia untuk disetujui.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
